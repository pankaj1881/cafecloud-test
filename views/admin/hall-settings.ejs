<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hall Booking Settings - Cafe Cloud</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen">
    <nav class="bg-gray-900 border-b border-gray-800 p-4">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">Hall Booking Settings</h1>
            <a href="/admin/dashboard" class="bg-blue-600 hover:bg-blue-700 px-6 py-3 rounded-lg font-bold">Back to Dashboard</a>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8 max-w-2xl">
        <h1 class="text-3xl font-bold mb-6">Hall Booking Settings</h1>

        <% if (success) { %>
            <div class="bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg mb-6">
                Settings updated successfully!
            </div>
        <% } %>

        <form action="/admin/hall-settings" method="POST" class="bg-gray-800 rounded-xl p-6 shadow-lg">
            <div class="mb-6">
                <label class="block text-sm font-bold mb-2">Minimum Booking Hours</label>
                <input type="number" name="minimumBookingHours" 
                    value="<%= settings?.hallBookingSettings?.minimumBookingHours || 2 %>" 
                    min="1" required 
                    class="w-full bg-gray-700 text-white px-4 py-3 rounded-lg">
                <p class="text-sm text-gray-400 mt-1">Minimum hours required for a booking</p>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-bold mb-2">Buffer Time (Minutes)</label>
                <input type="number" name="bufferTimeMinutes" 
                    value="<%= settings?.hallBookingSettings?.bufferTimeMinutes || 30 %>" 
                    min="0" required 
                    class="w-full bg-gray-700 text-white px-4 py-3 rounded-lg">
                <p class="text-sm text-gray-400 mt-1">Time gap between bookings for cleaning/setup</p>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-4 rounded-lg text-lg">
                Save Settings
            </button>
        </form>
    </div>
</body>
</html>
