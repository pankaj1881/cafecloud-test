<!DOCTYPE html>
<html>
<head>
    <title>Menu Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spinner {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
    </style>
</head>
<body class="bg-gray-900 text-white min-h-screen p-4 md:p-6">

<!-- Global Loading Overlay -->
<div id="pageLoadingOverlay" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center">
    <div class="text-center">
        <div class="text-6xl mb-4 spinner">⚙️</div>
        <div class="text-2xl font-bold text-white">Loading...</div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-4xl font-bold bg-gradient-to-r from-sky-400 to-orange-500 bg-clip-text text-transparent">
            🍽️ Menu Management
        </h1>
        <a href="/admin/dashboard" class="bg-gray-800 hover:bg-gray-700 px-4 py-2 rounded-lg border border-gray-700">
            ← Back
        </a>
    </div>

    <!-- Tabs -->
    <div class="flex gap-4 mb-6 border-b border-gray-700">
        <button onclick="switchTab('categories')" id="categoriesTab" class="px-6 py-3 font-semibold border-b-2 border-sky-400 text-sky-400">
            Categories
        </button>
        <button onclick="switchTab('items')" id="itemsTab" class="px-6 py-3 font-semibold border-b-2 border-transparent text-gray-400 hover:text-white">
            Menu Items
        </button>
    </div>

    <!-- Categories Section -->
    <div id="categoriesSection">
        <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 mb-6">
            <h2 class="text-2xl font-bold mb-4 text-sky-400">Add New Category</h2>
            <form method="POST" action="/admin/categories/add" class="flex gap-4">
                <input type="text" name="name" placeholder="Category Name" required
                    class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-4 py-2 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                <button type="submit" class="bg-sky-500 hover:bg-sky-600 px-6 py-2 rounded-lg font-semibold">
                    <span class="btn-text">Add Category</span>
                    <span class="btn-spinner hidden spinner">⚙️</span>
                </button>
            </form>
        </div>

        <div class="bg-gray-800 border border-gray-700 rounded-xl p-6">
            <h2 class="text-2xl font-bold mb-4 text-sky-400">All Categories</h2>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-700">
                            <th class="text-left py-3 px-4 text-gray-400">Category Name</th>
                            <th class="text-center py-3 px-4 text-gray-400">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(category => { %>
                            <tr class="border-b border-gray-700/50 hover:bg-gray-700/30">
                                <td class="py-3 px-4 font-semibold"><%= category.name %></td>
                                <td class="py-3 px-4 text-center">
                                    <a href="/admin/categories/delete/<%= category._id %>" 
                                        onclick="return confirm('⚠️ Warning: Deleting this category will also delete all menu items in this category and their images from cloud storage. Are you sure?') && showLoading()"
                                        class="text-red-400 hover:text-red-300 font-semibold">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                        <% if (categories.length === 0) { %>
                            <tr>
                                <td colspan="2" class="py-8 text-center text-gray-500">No categories found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Menu Items Section -->
    <div id="itemsSection" class="hidden">
        <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 mb-6">
            <div class="flex justify-between items-center">
                <h2 class="text-2xl font-bold text-orange-400">All Menu Items</h2>
                <a href="/admin/menu/add" class="bg-orange-500 hover:bg-orange-600 px-6 py-2 rounded-lg font-semibold">
                    + Add Menu Item
                </a>
            </div>
        </div>

        <% if (categories.length === 0) { %>
            <div class="text-center py-12 text-gray-500">
                No categories found. Please add categories first.
            </div>
        <% } else if (items.length === 0) { %>
            <div class="text-center py-12 text-gray-500">
                No menu items found. Click "+ Add Menu Item" to get started.
            </div>
        <% } else { %>
            <% categories.forEach(category => { %>
                <% const categoryItems = items.filter(item => item.category?._id.toString() === category._id.toString()); %>
                <% if (categoryItems.length > 0) { %>
                    <div class="bg-gray-800 border border-gray-700 rounded-xl mb-4">
                        <div class="flex justify-between items-center p-6 cursor-pointer select-none hover:bg-gray-700/30 rounded-xl transition-colors" onclick="toggleCategory(this)">
                            <div class="flex items-center gap-3">
                                <span class="category-arrow text-gray-400 transition-transform duration-200">▶</span>
                                <h3 class="text-2xl font-bold text-sky-400"><%= category.name %></h3>
                            </div>
                            <% 
                                const availableCount = categoryItems.filter(item => item.isAvailable).length;
                                const outOfStockCount = categoryItems.length - availableCount;
                            %>
                            <span class="text-gray-400 text-sm">
                                <%= categoryItems.length %> <%= categoryItems.length === 1 ? 'item' : 'items' %>
                                <% if (outOfStockCount > 0) { %>
                                    <span class="text-red-400">(<%= outOfStockCount %> out of stock)</span>
                                <% } %>
                            </span>
                        </div>
                        
                        <div class="category-items hidden px-6 pb-6">
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                            <% categoryItems.forEach(item => { %>
                                <div class="bg-gray-900 border border-gray-700 rounded-xl overflow-hidden hover:border-orange-500/50 transition-all <%= !item.isAvailable ? 'opacity-75' : '' %>">
                                    <% if (item.image) { %>
                                        <img src="<%= getImageUrl(item.image) %>" alt="<%= item.name %>" class="w-full h-40 object-cover <%= !item.isAvailable ? 'grayscale' : '' %>">
                                    <% } else { %>
                                        <div class="w-full h-40 bg-gray-700 flex items-center justify-center text-gray-500">
                                            No Image
                                        </div>
                                    <% } %>
                                    <div class="p-4">
                                        <div class="flex items-center gap-2 mb-2">
                                            <% if (item.foodType === 'veg') { %>
                                                <span class="text-green-500 text-xl">🟢</span>
                                            <% } else if (item.foodType === 'non-veg') { %>
                                                <span class="text-red-500 text-xl">🔴</span>
                                            <% } else if (item.foodType === 'beverage') { %>
                                                <span class="text-yellow-500 text-xl">🟡</span>
                                            <% } else if (item.foodType === 'other') { %>
                                                <span class="text-gray-400 text-xl">⚪</span>
                                            <% } %>
                                            <h4 class="text-lg font-bold"><%= item.name %></h4>
                                        </div>
                                        <p class="text-green-400 font-bold text-lg mb-2">₹<%= item.price %></p>
                                        <% if (item.description) { %>
                                            <p class="text-gray-400 text-sm mb-3 line-clamp-2"><%= item.description %></p>
                                        <% } %>
                                        
                                        <!-- Availability Toggle -->
                                        <button onclick="toggleAvailability('<%= item._id %>', <%= item.isAvailable %>)" 
                                            id="toggle-<%= item._id %>"
                                            class="block w-full text-center py-2 rounded-lg font-semibold mb-2 transition-all <%= item.isAvailable ? 'bg-green-500/20 hover:bg-green-500/30 text-green-400 border border-green-500/30' : 'bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30' %>">
                                            <%= item.isAvailable ? '🟢 Available' : '🔴 Out of Stock' %>
                                        </button>
                                        
                                        <a href="/admin/menu/edit/<%= item._id %>" 
                                            class="block text-center bg-blue-500/20 hover:bg-blue-500/30 text-blue-400 py-2 rounded-lg font-semibold border border-blue-500/30">
                                            Edit
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        </div>
                    </div>
                <% } %>
            <% }) %>
        <% } %>
    </div>
</div>

<script>
function switchTab(tab) {
    const categoriesTab = document.getElementById('categoriesTab');
    const itemsTab = document.getElementById('itemsTab');
    const categoriesSection = document.getElementById('categoriesSection');
    const itemsSection = document.getElementById('itemsSection');

    if (tab === 'categories') {
        categoriesTab.classList.add('border-sky-400', 'text-sky-400');
        categoriesTab.classList.remove('border-transparent', 'text-gray-400');
        itemsTab.classList.remove('border-orange-500', 'text-orange-500');
        itemsTab.classList.add('border-transparent', 'text-gray-400');
        categoriesSection.classList.remove('hidden');
        itemsSection.classList.add('hidden');
    } else {
        itemsTab.classList.add('border-orange-500', 'text-orange-500');
        itemsTab.classList.remove('border-transparent', 'text-gray-400');
        categoriesTab.classList.remove('border-sky-400', 'text-sky-400');
        categoriesTab.classList.add('border-transparent', 'text-gray-400');
        itemsSection.classList.remove('hidden');
        categoriesSection.classList.add('hidden');
    }
}

function toggleAvailability(itemId, currentStatus) {
    const button = document.getElementById('toggle-' + itemId);
    const card = button.closest('.bg-gray-900');
    const img = card.querySelector('img');
    
    // Show spinner
    const originalText = button.textContent;
    button.innerHTML = '<span class="spinner">⚙️</span>';
    button.disabled = true;
    
    fetch('/admin/menu/toggle/' + itemId, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            // Toggle the status
            const newStatus = !currentStatus;
            
            // Update button
            if (newStatus) {
                button.textContent = '🟢 Available';
                button.className = 'block w-full text-center py-2 rounded-lg font-semibold mb-2 transition-all bg-green-500/20 hover:bg-green-500/30 text-green-400 border border-green-500/30';
                card.classList.remove('opacity-75');
                if (img) img.classList.remove('grayscale');
            } else {
                button.textContent = '🔴 Out of Stock';
                button.className = 'block w-full text-center py-2 rounded-lg font-semibold mb-2 transition-all bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30';
                card.classList.add('opacity-75');
                if (img) img.classList.add('grayscale');
            }
            
            // Update onclick attribute
            button.setAttribute('onclick', 'toggleAvailability("' + itemId + '", ' + newStatus + ')');
            
            // Re-enable button
            button.disabled = false;
            
            // Reload page to update counts, stay on items tab
            showLoading();
            setTimeout(() => {
                window.location.href = '/admin/menu-management?tab=items';
            }, 500);
        } else {
            alert('Error: ' + (data.error || 'Failed to update availability'));
            button.textContent = originalText;
            button.disabled = false;
        }
    })
    .catch(err => {
        alert('Network error: ' + err.message);
        button.textContent = originalText;
        button.disabled = false;
    });
}

// Check URL parameter on page load
window.addEventListener('DOMContentLoaded', function() {
    document.getElementById('pageLoadingOverlay').classList.add('hidden');
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    if (tab === 'items') {
        switchTab('items');
    }
    
    // Add loading to forms
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const btn = this.querySelector('button[type="submit"]');
            if (btn) {
                const textSpan = btn.querySelector('.btn-text');
                const spinnerSpan = btn.querySelector('.btn-spinner');
                if (textSpan && spinnerSpan) {
                    textSpan.classList.add('hidden');
                    spinnerSpan.classList.remove('hidden');
                    btn.disabled = true;
                }
            }
        });
    });
    
    // Add loading to navigation links
    document.querySelectorAll('a[href^="/admin/menu/"]').forEach(link => {
        link.addEventListener('click', function() {
            if (!this.getAttribute('onclick') || !this.getAttribute('onclick').includes('confirm')) {
                showLoading();
            }
        });
    });
});

window.addEventListener('pageshow', function(e) { if (e.persisted) document.getElementById('pageLoadingOverlay').classList.add('hidden'); });

function showLoading() {
    document.getElementById('pageLoadingOverlay').classList.remove('hidden');
    return true;
}

function toggleCategory(header) {
    const items = header.nextElementSibling;
    const arrow = header.querySelector('.category-arrow');
    items.classList.toggle('hidden');
    arrow.style.transform = items.classList.contains('hidden') ? '' : 'rotate(90deg)';
}
</script>

</body>
</html>
