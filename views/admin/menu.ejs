<!DOCTYPE html>
<html>
<head>
    <title>Manage Menu</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white p-10">

<h1 class="text-3xl mb-6">Manage Menu Items</h1>

<a href="/admin/menu/add" class="bg-blue-500 px-4 py-2 rounded">
    Add New Item
</a>

<table class="mt-6 w-full border-collapse">
    <tr class="border-b border-gray-700">
        <th class="text-left p-2">Name</th>
        <th class="text-left p-2">Category</th>
        <th class="text-left p-2">Price</th>
        <th class="text-left p-2">Action</th>
    </tr>

    <% items.forEach(item => { %>
        <tr class="border-b border-gray-800">
            <td class="p-2"><%= item.name %></td>
            <td class="p-2"><%= item.category?.name %></td>
            <td class="p-2">₹<%= item.price %></td>
            <td class="p-2">
                <a href="/admin/menu/delete/<%= item._id %>" 
                   onclick="return confirm('Are you sure you want to delete this menu item?')"
                   class="text-red-400">Delete</a>
            </td>
        </tr>
    <% }) %>
</table>

<a href="/admin/dashboard" class="block mt-6 text-blue-400">
    Back to Dashboard
</a>

</body>
</html>