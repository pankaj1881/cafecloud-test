<!DOCTYPE html>
<html>
<head>
    <title>Admin Login</title>
    <%- include("../partials/favicon") %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Nunito', sans-serif; }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .input-focus:focus { box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
    </style>
</head>
<body class="h-screen overflow-hidden">

    <div class="flex h-full">
        <!-- Left Side - Hero Image (same style as home page) -->
        <div class="hidden md:flex md:w-2/5 lg:w-1/2 relative bg-cover bg-center" style="background-image: url('/images/hero.jpg')">
            <div class="absolute inset-0 bg-gradient-to-b from-black via-black/70 to-black"></div>
            <div class="relative z-10 flex flex-col items-center justify-center w-full px-12 text-center">
                <div class="mb-4">
                    <img src="/images/logo.png" alt="Logo" class="w-48 h-48 mx-auto object-contain">
                </div>
                <h1 class="text-6xl font-extrabold tracking-tight">
                    <span class="text-sky-400 drop-shadow-[0_0_30px_rgba(56,189,248,0.5)]">Cafe</span>
                    <span class="text-orange-500 drop-shadow-[0_0_30px_rgba(251,146,60,0.5)]">Cloud</span>
                </h1>
            </div>
        </div>

        <!-- Right Side - Login Form -->
        <div class="w-full md:w-3/5 lg:w-1/2 bg-sky-50 flex flex-col">
            <!-- Mobile Hero Banner (same style as home page) -->
            <div class="md:hidden relative h-[30vh] min-h-[180px] bg-cover bg-center" style="background-image: url('/images/hero.jpg')">
                <div class="absolute inset-0 bg-gradient-to-b from-black via-black/70 to-black"></div>
                <div class="relative z-10 flex flex-col items-center justify-center h-full">
                    <img src="/images/logo.png" alt="Logo" class="w-20 h-20 mx-auto object-contain mb-2">
                    <h1 class="text-3xl font-extrabold tracking-tight">
                        <span class="text-sky-400">Cafe</span>
                        <span class="text-orange-500">Cloud</span>
                    </h1>
                </div>
            </div>

            <!-- Login Form Area -->
            <div class="flex-1 flex items-center justify-center px-6 py-8">
                <div class="w-full max-w-sm">
                    <a href="/" class="inline-flex items-center text-blue-500 hover:text-blue-600 text-sm mb-6 fade-in-up">
                        ← Back to Home
                    </a>

                    <h2 class="text-2xl font-extrabold text-gray-800 mb-1 fade-in-up">Welcome back 👋</h2>
                    <p class="text-gray-400 text-sm mb-8 fade-in-up">Sign in to your admin dashboard</p>

                    <% if (error) { %>
                        <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-5 text-sm flex items-center gap-2">
                            <span>⚠️</span> <%= error %>
                        </div>
                    <% } %>

                    <form action="/admin/login" method="POST">
                        <div class="mb-4 fade-in-up">
                            <label class="block text-gray-600 text-xs font-bold mb-2">EMAIL</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">📧</span>
                                <input type="email" name="email" placeholder="admin@example.com"
                                    class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-gray-700 text-sm input-focus focus:border-blue-400 focus:outline-none transition" required>
                            </div>
                        </div>

                        <div class="mb-6 fade-in-up">
                            <label class="block text-gray-600 text-xs font-bold mb-2">PASSWORD</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔒</span>
                                <input type="password" name="password" id="password" placeholder="••••••••"
                                    class="w-full pl-10 pr-11 py-3 border border-gray-200 rounded-xl text-gray-700 text-sm input-focus focus:border-blue-400 focus:outline-none transition" required>
                                <button type="button" onclick="togglePassword()" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-sm">
                                    <span id="eyeIcon">👁️</span>
                                </button>
                            </div>
                        </div>

                        <button type="submit"
                            class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 transition-all duration-200 fade-in-up">
                            Sign In
                        </button>
                    </form>

                    <div class="text-center mt-5 fade-in-up">
                        <a href="/admin/forgot-password" class="text-blue-500 hover:text-blue-600 text-sm">Forgot password?</a>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center py-4 text-gray-300 text-xs">
                Powered by Cafe Cloud ☁️
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = '🙈';
            } else {
                input.type = 'password';
                icon.textContent = '👁️';
            }
        }
    </script>
</body>
</html>
