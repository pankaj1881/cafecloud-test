<!DOCTYPE html>
<html>
<head>
    <title>Manage Categories</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white p-10">

<h1 class="text-3xl mb-6">Manage Categories</h1>

<form action="/admin/categories/add" method="POST" class="mb-6">
    <input type="text" name="name" placeholder="Category Name"
        class="p-2 text-black rounded" required>
    <button class="bg-blue-500 px-4 py-2 rounded">Add</button>
</form>

<ul>
    <% categories.forEach(cat => { %>
        <li class="mb-2">
            <%= cat.name %>
            <a href="/admin/categories/delete/<%= cat._id %>"
               onclick="return confirm('Are you sure you want to delete this category? All menu items in this category will also be deleted!')"
               class="text-red-400 ml-4">Delete</a>
        </li>
    <% }) %>
</ul>

<a href="/admin/dashboard" class="block mt-6 text-blue-400">
    Back to Dashboard
</a>

</body>
</html>