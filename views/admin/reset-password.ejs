<!DOCTYPE html>
<html>
<head>
    <title>Reset Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 flex items-center justify-center h-screen">

<form action="/admin/reset-password" method="POST" class="bg-gray-800 p-8 rounded-lg w-96 text-white">
    <h2 class="text-2xl mb-2 text-center">Reset Password</h2>
    <p class="text-gray-400 text-sm mb-6 text-center">Enter your new password</p>

    <% if (error) { %>
        <div class="bg-red-500 text-white p-3 rounded mb-4 text-sm">
            <%= error %>
        </div>
    <% } %>

    <% if (token) { %>
        <input type="hidden" name="token" value="<%= token %>">

        <input type="password" name="password" placeholder="New Password" minlength="6"
            class="w-full p-2 mb-4 rounded text-black" required>

        <input type="password" name="confirmPassword" placeholder="Confirm Password" minlength="6"
            class="w-full p-2 mb-4 rounded text-black" required>

        <button class="w-full bg-orange-500 p-2 rounded hover:bg-orange-600 mb-3">
            Reset Password
        </button>
    <% } %>

    <div class="text-center">
        <a href="/admin" class="text-blue-400 hover:text-blue-300 text-sm">Back to Login</a>
    </div>
</form>

</body>
</html>
