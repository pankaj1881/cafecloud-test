<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 flex items-center justify-center h-screen">

<form action="/admin/forgot-password" method="POST" class="bg-gray-800 p-8 rounded-lg w-96 text-white">
    <h2 class="text-2xl mb-2 text-center">Forgot Password</h2>
    <p class="text-gray-400 text-sm mb-6 text-center">Enter your email to reset password</p>

    <% if (error) { %>
        <div class="bg-red-500 text-white p-3 rounded mb-4 text-sm">
            <%= error %>
        </div>
    <% } %>

    <% if (success) { %>
        <div class="bg-green-500 text-white p-3 rounded mb-4 text-sm">
            <%= success %>
        </div>
    <% } %>

    <input type="email" name="email" placeholder="Email"
        class="w-full p-2 mb-4 rounded text-black" required>

    <button class="w-full bg-orange-500 p-2 rounded hover:bg-orange-600 mb-3">
        Send Reset Link
    </button>

    <div class="text-center">
        <a href="/admin" class="text-blue-400 hover:text-blue-300 text-sm">Back to Login</a>
    </div>
</form>

</body>
</html>
