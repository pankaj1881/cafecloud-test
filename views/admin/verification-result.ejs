<!DOCTYPE html>
<html>
<head>
    <title>Email Verification</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 flex items-center justify-center h-screen">

<div class="bg-gray-800 p-8 rounded-lg w-96 text-white text-center">
    <% if (success) { %>
        <div class="text-6xl mb-4">✅</div>
        <h2 class="text-2xl mb-4 text-green-400">Success!</h2>
    <% } else { %>
        <div class="text-6xl mb-4">❌</div>
        <h2 class="text-2xl mb-4 text-red-400">Verification Failed</h2>
    <% } %>
    
    <p class="text-gray-300 mb-6"><%= message %></p>
    
    <a href="/admin" class="inline-block bg-blue-500 px-6 py-2 rounded hover:bg-blue-600">
        Go to Login
    </a>
</div>

</body>
</html>
