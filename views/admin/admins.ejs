<!DOCTYPE html>
<html>
<head>
    <title>Admin Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spinner {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
    </style>
</head>
<body class="bg-gray-900 text-white">

<!-- Global Loading Overlay -->
<div id="pageLoadingOverlay" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center">
    <div class="text-center">
        <div class="text-6xl mb-4 spinner">⚙️</div>
        <div class="text-2xl font-bold text-white">Loading...</div>
    </div>
</div>

<div class="container mx-auto p-6">
    <div class="mb-6">
        <a href="/admin/dashboard" class="text-blue-400 hover:text-blue-300">&larr; Back to Dashboard</a>
    </div>
    
    <h1 class="text-3xl font-bold mb-6">Admin Management</h1>

    <% if (pendingCount > 0) { %>
    <div class="bg-orange-500 text-white rounded-lg p-4 mb-6 flex items-center justify-between">
        <div>
            <span class="font-bold text-lg">⚠ <%= pendingCount %> Admin<%= pendingCount > 1 ? 's' : '' %> Pending Approval</span>
            <p class="text-sm mt-1">Review and approve or reject the pending admin registrations below.</p>
        </div>
    </div>
    <% } %>

    <!-- Invite New Admin -->
    <div class="bg-gray-800 rounded-lg p-6 mb-6">
        <h2 class="text-xl font-bold mb-4">Invite New Admin</h2>
        
        <!-- Admin Tools -->
        <div class="bg-gray-700 p-3 rounded mb-4">
            <button onclick="checkAdminStatus()" class="bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded text-sm mr-2">
                🔍 Check Admin Status
            </button>
            <button onclick="cleanupUnverified()" class="bg-orange-500 hover:bg-orange-600 px-4 py-2 rounded text-sm">
                🧹 Cleanup Unverified
            </button>
        </div>

        <div class="flex gap-3">
            <input type="email" id="inviteEmail" placeholder="Enter email address" 
                   class="flex-1 p-2 rounded text-black">
            <button onclick="sendInvitation(this)" 
                    class="bg-green-500 hover:bg-green-600 px-6 py-2 rounded font-semibold">
                <span class="btn-text">Send Invitation</span>
                <span class="btn-spinner hidden spinner">⚙️</span>
            </button>
        </div>
        <p class="text-gray-400 text-sm mt-2">An invitation link will be sent to the email address</p>
    </div>

    <div class="bg-gray-800 rounded-lg p-6">
        <table class="w-full">
            <thead>
                <tr class="border-b border-gray-700">
                    <th class="text-left p-3">Email</th>
                    <th class="text-left p-3">Role</th>
                    <th class="text-left p-3">Status</th>
                    <th class="text-left p-3">Created</th>
                    <th class="text-center p-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (admins.length === 0) { %>
                    <tr>
                        <td colspan="5" class="text-center p-6 text-gray-400">No registered admins</td>
                    </tr>
                <% } else { %>
                    <% admins.forEach(admin => { %>
                        <tr class="border-b border-gray-700 hover:bg-gray-750">
                            <td class="p-3"><%= admin.email %></td>
                            <td class="p-3"><span class="bg-orange-500 px-2 py-1 rounded text-xs"><%= admin.role %></span></td>
                            <td class="p-3">
                                <% if (!admin.isVerified) { %>
                                    <span class="bg-yellow-500 px-2 py-1 rounded text-xs">Email Pending</span>
                                <% } else if (!admin.isApproved) { %>
                                    <span class="bg-orange-500 px-2 py-1 rounded text-xs">Approval Pending</span>
                                <% } else { %>
                                    <span class="bg-green-500 px-2 py-1 rounded text-xs">Active</span>
                                <% } %>
                            </td>
                            <td class="p-3"><%= new Date(admin.createdAt).toLocaleDateString() %></td>
                            <td class="p-3 text-center">
                                <% if (admin.isVerified && !admin.isApproved) { %>
                                    <button onclick="approveAdmin('<%= admin._id %>', this)" 
                                            class="bg-green-500 hover:bg-green-600 px-3 py-1 rounded text-sm mr-2">
                                        <span class="btn-text">Approve</span>
                                        <span class="btn-spinner hidden spinner">⚙️</span>
                                    </button>
                                    <button onclick="rejectAdmin('<%= admin._id %>', this)" 
                                            class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm">
                                        <span class="btn-text">Reject</span>
                                        <span class="btn-spinner hidden spinner">⚙️</span>
                                    </button>
                                <% } else { %>
                                    <a href="/admin/admins/delete/<%= admin._id %>" 
                                       onclick="return confirm('Delete this admin?') && showLoading()"
                                       class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm">
                                        Delete
                                    </a>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function sendInvitation(btn) {
    const email = document.getElementById('inviteEmail').value;
    
    if (!email) {
        alert('Please enter an email address');
        return;
    }
    
    if (!email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        alert('Please enter a valid email address');
        return;
    }
    
    if (btn) {
        btn.querySelector('.btn-text').classList.add('hidden');
        btn.querySelector('.btn-spinner').classList.remove('hidden');
        btn.disabled = true;
    }
    
    fetch('/admin/admins/invite', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('Invitation sent successfully to ' + email);
            document.getElementById('inviteEmail').value = '';
            location.reload();
        } else {
            alert('Failed to send invitation: ' + (data.error || 'Unknown error'));
            if (btn) {
                btn.querySelector('.btn-text').classList.remove('hidden');
                btn.querySelector('.btn-spinner').classList.add('hidden');
                btn.disabled = false;
            }
        }
    })
    .catch(err => {
        alert('Error: ' + err.message);
        if (btn) {
            btn.querySelector('.btn-text').classList.remove('hidden');
            btn.querySelector('.btn-spinner').classList.add('hidden');
            btn.disabled = false;
        }
    });
}

function checkAdminStatus() {
    fetch('/admin/admins/debug')
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            const stats = data.stats;
            let message = `=== ADMIN STATUS ===\n\n`;
            message += `Total Admins: ${stats.total}\n`;
            message += `Verified: ${stats.verified}\n`;
            message += `Approved: ${stats.approved}\n`;
            message += `Pending Approval: ${stats.pendingApproval}\n`;
            message += `Unverified: ${stats.unverified}\n`;
            message += `Remaining Slots: ${stats.remainingSlots}/3\n\n`;
            message += `=== ADMINS ===\n`;
            data.admins.forEach((admin, i) => {
                message += `\n${i+1}. ${admin.email}\n`;
                message += `   Verified: ${admin.isVerified ? '✓' : '✗'}\n`;
                message += `   Approved: ${admin.isApproved ? '✓' : '✗'}\n`;
            });
            alert(message);
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

function cleanupUnverified() {
    if (!confirm('Delete all unverified admins (who never clicked invitation link)?')) return;
    
    fetch('/admin/admins/cleanup-unverified', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert(`✓ Deleted ${data.deletedCount} unverified admin(s)`);
            location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

function approveAdmin(adminId, btn) {
    if (!confirm('Approve this admin?')) return;
    
    if (btn) {
        btn.querySelector('.btn-text').classList.add('hidden');
        btn.querySelector('.btn-spinner').classList.remove('hidden');
        btn.disabled = true;
    }
    
    fetch(`/admin/admins/approve/${adminId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('Admin approved successfully!');
            location.reload();
        } else {
            alert('Failed to approve admin: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(err => {
        alert('Error: ' + err.message);
    });
}

function rejectAdmin(adminId, btn) {
    if (!confirm('Reject and delete this admin?')) return;
    
    if (btn) {
        btn.querySelector('.btn-text').classList.add('hidden');
        btn.querySelector('.btn-spinner').classList.remove('hidden');
        btn.disabled = true;
    }
    
    fetch(`/admin/admins/reject/${adminId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('Admin rejected and deleted successfully!');
            location.reload();
        } else {
            alert('Failed to reject admin: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(err => {
        alert('Error: ' + err.message);
    });
}

function showLoading() {
    document.getElementById('pageLoadingOverlay').classList.remove('hidden');
    return true;
}

document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('pageLoadingOverlay').classList.add('hidden');
    document.querySelectorAll('a[href^="/admin/"]:not([href*="logout"])').forEach(link => {
        link.addEventListener('click', function() {
            if (!this.getAttribute('onclick') || !this.getAttribute('onclick').includes('confirm')) {
                document.getElementById('pageLoadingOverlay').classList.remove('hidden');
            }
        });
    });
});
window.addEventListener('pageshow', function(e) { if (e.persisted) document.getElementById('pageLoadingOverlay').classList.add('hidden'); });
</script>

</body>
</html>
