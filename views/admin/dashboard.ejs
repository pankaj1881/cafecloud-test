<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <%- include("../partials/favicon") %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spinner {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
    </style>
</head>
<body class="bg-gray-900 text-white p-4 md:p-10">

<!-- Global Loading Overlay -->
<div id="pageLoadingOverlay" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center">
    <div class="text-center">
        <div class="text-6xl mb-4 spinner">⚙️</div>
        <div class="text-2xl font-bold text-white">Loading...</div>
    </div>
</div>

<h1 class="text-3xl mb-6">Welcome to Admin Dashboard</h1>

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    <!-- Website Management -->
    <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold text-sky-400 mb-4">Website</h2>
        <a href="/admin/menu-management" class="block mb-2 text-blue-400 hover:text-blue-300">→ Menu Management</a>
        <a href="/admin/gallery" class="block mb-2 text-blue-400 hover:text-blue-300">→ Manage Gallery</a>
        <a href="/admin/delivery-partners" class="block mb-2 text-blue-400 hover:text-blue-300">→ Delivery Partners</a>
        <a href="/admin/announcements" class="block mb-2 text-blue-400 hover:text-blue-300">→ Announcements</a>
        <a href="/admin/settings" class="block mb-2 text-blue-400 hover:text-blue-300">→ Website Settings</a>
    </div>
    
    <!-- Restaurant Operations -->
    <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold text-orange-400 mb-4">Operations</h2>
        <a href="/admin/tables" class="block mb-2 text-blue-400 hover:text-blue-300">→ Table & Hall Management</a>
        <a href="/waiter/dashboard" class="block mb-2 text-blue-400 hover:text-blue-300">→ Order Dashboard</a>
        <a href="/admin/dashboard-pins" class="block mb-2 text-blue-400 hover:text-blue-300">→ Dashboard PINs</a>
        <button onclick="showStaffQR()" class="block mb-2 text-green-400 hover:text-green-300 font-bold">→ 📱 Staff App QR</button>

    </div>
    
    <!-- Analytics -->
    <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold text-green-400 mb-4">Analytics</h2>
        <a href="/admin/orders" class="block mb-2 text-blue-400 hover:text-blue-300">→ View All Orders</a>
        <a href="/admin/sales-analysis" class="block mb-2 text-blue-400 hover:text-blue-300">→ Sales Analysis</a>
        <a href="/admin/feedback" class="block mb-2 text-blue-400 hover:text-blue-300">→ Customer Feedback</a>
    </div>
    
    <% if (isMaster) { %>
    <!-- Master Admin Only -->
    <div class="bg-gray-800 rounded-lg p-6 border-2 border-red-500">
        <h2 class="text-xl font-bold text-red-400 mb-4">Master Admin</h2>
        <a href="/admin/admins" class="block mb-2 text-blue-400 hover:text-blue-300 flex items-center justify-between">
            <span>→ Manage Admins</span>
            <% if (pendingApprovals > 0) { %>
                <span class="bg-red-500 text-white px-2 py-1 rounded-full text-xs font-bold animate-pulse"><%= pendingApprovals %> Pending</span>
            <% } %>
        </a>
    </div>
    <% } %>
    
    <!-- Maintenance Mode (All Admins) -->
    <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold text-purple-400 mb-4">System</h2>
        <a href="/admin/maintenance-mode" class="block mb-2 text-blue-400 hover:text-blue-300">→ 🔧 Maintenance Mode</a>
        <% if (process.env.MAINTENANCE_MODE === 'true') { %>
            <div class="mt-3 bg-red-500 text-white px-3 py-2 rounded text-sm font-bold animate-pulse">
                ⚠️ MAINTENANCE ACTIVE
            </div>
        <% } %>
    </div>
</div>

<a href="/admin/logout" class="text-red-400 hover:text-red-300 underline mt-4 block">
    Logout
</a>

<!-- Staff App QR Modal -->
<div id="staffQRModal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 rounded-xl max-w-md w-full p-6 border-2 border-sky-500">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-sky-400">📱 Staff App Access</h2>
            <button onclick="closeStaffQR()" class="text-red-400 hover:text-red-300 text-2xl font-bold">×</button>
        </div>
        
        <div class="text-center mb-4">
            <div class="bg-white p-4 rounded-lg inline-block mb-4">
                <div id="qrcode"></div>
            </div>
            <p class="text-gray-300 text-sm mb-2">Scan this QR code to install Staff App</p>
            <p class="text-gray-400 text-xs">Works for Waiter, Kitchen & Hall dashboards</p>
        </div>
        
        <div class="bg-gray-800 rounded-lg p-4 mb-4">
            <p class="text-xs text-gray-400 mb-2">Or share this link:</p>
            <div class="flex gap-2">
                <input type="text" id="staffAppUrl" readonly 
                    class="flex-1 bg-gray-700 text-white px-3 py-2 rounded text-sm" 
                    value="">
                <button onclick="copyStaffUrl()" class="bg-sky-600 hover:bg-sky-700 px-4 py-2 rounded text-sm font-bold">
                    Copy
                </button>
            </div>
        </div>
        
        <div class="flex gap-2">
            <button onclick="downloadQR()" class="flex-1 bg-green-600 hover:bg-green-700 px-4 py-3 rounded-lg font-bold">
                ⬇️ Download QR
            </button>
            <button onclick="printQR()" class="flex-1 bg-blue-600 hover:bg-blue-700 px-4 py-3 rounded-lg font-bold">
                🖨️ Print
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
let qrCodeInstance = null;

function showStaffQR() {
    const modal = document.getElementById('staffQRModal');
    const staffUrl = window.location.origin + '/waiter/login';
    document.getElementById('staffAppUrl').value = staffUrl;
    
    // Clear previous QR code
    const qrContainer = document.getElementById('qrcode');
    qrContainer.innerHTML = '';
    
    // Generate new QR code
    qrCodeInstance = new QRCode(qrContainer, {
        text: staffUrl,
        width: 200,
        height: 200,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
    });
    
    modal.classList.remove('hidden');
}

function closeStaffQR() {
    document.getElementById('staffQRModal').classList.add('hidden');
}

function copyStaffUrl() {
    const input = document.getElementById('staffAppUrl');
    input.select();
    document.execCommand('copy');
    alert('✅ Link copied to clipboard!');
}

function downloadQR() {
    const canvas = document.querySelector('#qrcode canvas');
    if (canvas) {
        const url = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = 'staff-app-qr.png';
        link.href = url;
        link.click();
    }
}

function printQR() {
    const printWindow = window.open('', '', 'width=600,height=600');
    const qrCanvas = document.querySelector('#qrcode canvas');
    const staffUrl = document.getElementById('staffAppUrl').value;
    
    printWindow.document.write(`
        <html>
        <head>
            <title>Staff App QR Code</title>
            <style>
                body { 
                    font-family: Arial, sans-serif; 
                    text-align: center; 
                    padding: 40px;
                }
                h1 { color: #0ea5e9; margin-bottom: 20px; }
                .qr-container { 
                    border: 3px solid #0ea5e9; 
                    padding: 20px; 
                    display: inline-block;
                    border-radius: 10px;
                    margin: 20px 0;
                }
                .instructions {
                    margin-top: 30px;
                    text-align: left;
                    max-width: 400px;
                    margin-left: auto;
                    margin-right: auto;
                }
                .instructions li { margin: 10px 0; }
                .url { 
                    background: #f0f0f0; 
                    padding: 10px; 
                    border-radius: 5px;
                    word-break: break-all;
                    margin-top: 20px;
                    font-size: 12px;
                }
            </style>
        </head>
        <body>
            <h1>📱 CAFE CLOUD - STAFF APP</h1>
            <div class="qr-container">
                ${qrCanvas.outerHTML}
            </div>
            <div class="instructions">
                <h3>How to Install:</h3>
                <ol>
                    <li>Scan QR code with your phone camera</li>
                    <li>Open the link in Chrome/Safari</li>
                    <li>Tap "Add to Home Screen"</li>
                    <li>Login with Staff PIN</li>
                </ol>
            </div>
            <div class="url">
                <strong>Direct Link:</strong><br>
                ${staffUrl}
            </div>
        </body>
        </html>
    `);
    
    printWindow.document.close();
    setTimeout(() => {
        printWindow.print();
    }, 250);
}

// Add loading to navigation links
document.addEventListener('DOMContentLoaded', function() {
    // Hide overlay on page load (safety net)
    document.getElementById('pageLoadingOverlay').classList.add('hidden');

    document.querySelectorAll('a[href^="/admin/"]:not([href*="logout"]), a[href^="/waiter/"]').forEach(link => {
        link.addEventListener('click', function() {
            document.getElementById('pageLoadingOverlay').classList.remove('hidden');
        });
    });
});

// Hide overlay when page is restored from browser back/forward cache
window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
        document.getElementById('pageLoadingOverlay').classList.add('hidden');
    }
});
</script>

</body>

</html>
