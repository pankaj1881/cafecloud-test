<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waiter Dashboard - Cafe Cloud</title>
   <%- include("../partials/favicon") %>
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#f97316">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logo.png">
   
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Store order data globally to avoid HTML encoding issues -->
    <script>
        window.ORDER_DATA = {
            <% parcelOrders.forEach((order, index) => { %>
                '<%= order._id %>': {
                    items: <%- JSON.stringify(order.items) %>,
                    totalAmount: <%= order.totalAmount %>
                }<%= index < parcelOrders.length - 1 || tables.some(t => t.currentOrderId && t.currentOrderId.items) ? ',' : '' %>
            <% }); %>
            <% let tableIndex = 0; %>
            <% tables.forEach((table) => { %>
                <% if (table.currentOrderId && table.currentOrderId.items) { %>
                    <%= tableIndex > 0 || parcelOrders.length > 0 ? ',' : '' %>'<%= table.currentOrderId._id %>': {
                        items: <%- JSON.stringify(table.currentOrderId.items) %>,
                        totalAmount: <%= table.currentOrderId.totalAmount %>
                    }
                    <% tableIndex++; %>
                <% } %>
            <% }); %>
        };
    </script>
    
    <style>
        @keyframes pulse-border {
            0%, 100% { box-shadow: 0 0 15px rgba(234, 179, 8, 0.6); }
            50% { box-shadow: 0 0 30px rgba(234, 179, 8, 1); }
        }
        .animate-pulse-border {
            animation: pulse-border 1.5s ease-in-out infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spinner {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
        @keyframes slideInDown {
            from {
                transform: translateY(-100%);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        @keyframes slideOutUp {
            from {
                transform: translateY(0);
                opacity: 1;
            }
            to {
                transform: translateY(-100%);
                opacity: 0;
            }
        }
        .toast-notification {
            animation: slideInDown 0.5s ease-out;
        }
        .toast-notification.hiding {
            animation: slideOutUp 0.5s ease-out;
        }
    </style>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen">
    <!-- Global Loading Overlay -->
    <div id="pageLoadingOverlay" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center">
        <div class="text-center">
            <div class="text-6xl mb-4 spinner">⚙️</div>
            <div class="text-2xl font-bold text-white">Loading...</div>
        </div>
    </div>
    
    <nav class="bg-gray-900 border-b border-gray-800 p-3 md:p-4">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-lg md:text-2xl font-bold">
                <span class="text-sky-400">Order</span> <span class="text-orange-500">Dashboard</span>
            </h1>
            <div class="flex gap-2">
                <button onclick="location.reload()" class="bg-green-600 hover:bg-green-700 px-3 py-2 md:px-6 md:py-3 text-sm md:text-lg font-bold rounded-lg">
                    🔄
                </button>
                <a href="/kitchen/dashboard" class="bg-blue-600 hover:bg-blue-700 px-3 py-2 md:px-6 md:py-3 text-sm md:text-lg font-bold rounded-lg"><span class="hidden md:inline">Kitchen</span><span class="md:hidden">🍳</span></a>
                <a href="/waiter/logout" class="bg-red-600 hover:bg-red-700 px-3 py-2 md:px-6 md:py-3 text-sm md:text-lg font-bold rounded-lg">Logout</a>
            </div>
        </div>
    </nav>


    <div class="container mx-auto px-2 md:px-4 py-4 md:py-8">
        <!-- Tab Navigation -->
        <div class="flex gap-2 mb-4 md:mb-6 overflow-x-auto pb-2">
            <button onclick="showTab('main')" id="tabMain" class="px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold bg-orange-600 text-white whitespace-nowrap text-sm md:text-base">
                Main
            </button>
            <button onclick="showTab('orders')" id="tabOrders" class="px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold bg-gray-700 text-white whitespace-nowrap text-sm md:text-base">
                Orders
            </button>
            <button onclick="showTab('halls')" id="tabHalls" class="px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold bg-gray-700 text-white whitespace-nowrap relative text-sm md:text-base">
                Halls
                <% if (todayTomorrowBookingsCount > 0) { %>
                    <span class="absolute -top-1 -right-1 bg-red-600 text-white px-1.5 py-0.5 rounded-full text-xs font-bold animate-pulse">!</span>
                <% } %>
            </button>
        </div>


        <!-- Main Dashboard Tab -->
        <div id="sectionMain">
        <!-- QR Ordering Toggle -->
        <div class="mb-4 md:mb-6 bg-gray-800 rounded-xl p-4 md:p-5 border-2 <%= qrOrderingEnabled ? 'border-green-500' : 'border-red-500' %>">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="text-3xl md:text-4xl"><%= qrOrderingEnabled ? '✅' : '🚫' %></div>
                    <div>
                        <h3 class="text-lg md:text-xl font-bold <%= qrOrderingEnabled ? 'text-green-400' : 'text-red-400' %>">
                            QR Ordering: <%= qrOrderingEnabled ? 'ENABLED' : 'DISABLED' %>
                        </h3>
                        <p class="text-xs md:text-sm text-gray-400">
                            <%= qrOrderingEnabled ? 'Customers can order via QR code' : 'Customers will see website redirect' %>
                        </p>
                    </div>
                </div>
                <button onclick="toggleQROrdering(this)" 
                    class="<%= qrOrderingEnabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %> px-6 py-3 rounded-lg font-bold text-sm md:text-base whitespace-nowrap">
                    <span class="btn-text"><%= qrOrderingEnabled ? '🚫 Disable' : '✅ Enable' %></span>
                    <span class="btn-spinner hidden spinner">⚙️</span>
                </button>
            </div>
        </div>
        
        <!-- Buttons -->
        <div class="mb-4 md:mb-8 flex flex-col gap-3">
            <a href="/waiter/order/parcel"
               class="inline-block bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 px-6 py-4 md:px-8 md:py-6 rounded-xl font-bold text-lg md:text-xl shadow-lg text-center">
                📦 Take Parcel Order
            </a>
            <button onclick="showPendingModal(this)"
               id="pendingOrdersBtn"
               class="inline-block bg-gradient-to-r from-yellow-500 to-yellow-600 hover:from-yellow-600 hover:to-yellow-700 px-6 py-4 md:px-8 md:py-6 rounded-xl font-bold text-lg md:text-xl shadow-lg text-center relative <%= pendingOrders.length > 0 ? 'animate-pulse-border' : '' %>">
                <span class="btn-text">⏳ Pending Orders</span>
                <span class="btn-spinner hidden spinner">⚙️</span>
                <span id="pendingBadge" class="<%= pendingOrders.length > 0 ? '' : 'hidden' %> absolute -top-1 -right-1 md:-top-2 md:-right-2 bg-red-600 text-white px-2 py-1 md:px-3 md:py-2 rounded-full text-xs md:text-sm font-bold animate-bounce"><%= pendingOrders.length %></span>
            </button>
        </div>


        <!-- Active Parcel Orders -->
        <% if (parcelOrders.length > 0) { %>
        <div class="mb-6 md:mb-8">
            <h2 class="text-xl md:text-2xl font-bold mb-3 md:mb-4">Active Parcels</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
                <% parcelOrders.forEach(order => {
                    let bgColor = 'from-orange-500 to-orange-600';
                    let statusText = 'Preparing';
                    let icon = '🍽️';
                    if (order.status === 'served') {
                        bgColor = 'from-blue-500 to-blue-600';
                        statusText = 'Ready for Billing';
                        icon = '💰';
                    }
                    const elapsed = Math.floor((Date.now() - new Date(order.orderTakenAt)) / 60000);
                %>
                    <div class="bg-gradient-to-br <%= bgColor %> rounded-xl p-3 md:p-4 shadow-lg">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <div class="text-xl md:text-2xl mb-1"><%= icon %></div>
                                <div class="text-lg md:text-xl font-bold">📦 <%= order.orderId %></div>
                                <div class="text-xs md:text-sm"><%= order.deliveryType === 'home-delivery' ? '🏠 Delivery' : '🏪 Pickup' %></div>
                                <div class="text-xs font-semibold mt-1"><%= statusText %></div>
                            </div>
                            <div class="text-xs bg-black/30 rounded px-2 py-1">⏱️ <%= elapsed %>m</div>
                        </div>
                        <div class="text-xs bg-black/30 rounded py-2 px-2 mb-2 max-h-20 md:max-h-24 overflow-y-auto">
                            <% order.items.forEach(item => {
                                let statusIcon = '⏳';
                                if (item.status === 'preparing') statusIcon = '🔥';
                                else if (item.status === 'ready') statusIcon = '✓';
                                else if (item.status === 'served') statusIcon = '✓✓';
                            %>
                                <div class="mb-1"><%= statusIcon %> <%= item.name %> x<%= item.quantity %></div>
                            <% }); %>
                        </div>
                        <div class="text-sm font-bold mb-2">Total: ₹<%= order.totalAmount %></div>
                        <button onclick="showBillDetailsById('<%= order._id %>', this)"
                            class="w-full bg-white text-blue-700 font-bold py-2 text-sm rounded-lg hover:bg-gray-100 mb-2">
                            <span class="btn-text">💰 Bill</span>
                            <span class="btn-spinner hidden spinner">⚙️</span>
                        </button>
                        <button onclick="showMoveOrderModal('<%= order._id %>', 'parcel', null)"
                            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 text-sm rounded-lg">
                            Move to Table
                        </button>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>


        <!-- Tables Grid -->
        <h2 class="text-xl md:text-2xl font-bold mb-4 md:mb-6">Tables</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4">
            <% tables.forEach(table => {
                let bgColor = 'from-green-500 to-green-600';
                let statusText = 'Available';
                let icon = '✓';
               
                if (table.status === 'busy') {
                    bgColor = 'from-orange-500 to-orange-600';
                    statusText = 'Serving';
                    icon = '🍽️';
                } else if (table.status === 'served') {
                    bgColor = 'from-orange-500 to-orange-600';
                    statusText = 'Serving';
                    icon = '🍽️';
                } else if (table.status === 'billing') {
                    bgColor = 'from-blue-500 to-blue-600';
                    statusText = 'Billing';
                    icon = '💰';
                }
               
                const elapsed = table.occupiedAt ? Math.floor((Date.now() - new Date(table.occupiedAt)) / 60000) : 0;
            %>
                <div class="bg-gradient-to-br <%= bgColor %> rounded-xl p-4 md:p-8 text-center shadow-lg">
                    <div class="text-4xl md:text-6xl mb-2 md:mb-3"><%= icon %></div>
                    <div class="text-2xl md:text-4xl font-bold mb-2 md:mb-3">T<%= table.tableNumber %></div>
                    <div class="text-xs md:text-base font-semibold mb-3 md:mb-4"><%= statusText %></div>
                   
                    <% if (table.status === 'empty') { %>
                        <a href="/waiter/order/dine-in/<%= table.tableNumber %>"
                           class="block bg-white text-green-700 font-bold py-2 md:py-3 text-sm md:text-lg rounded-lg hover:bg-gray-100">
                            Take Order
                        </a>
                    <% } else { %>
                        <div class="text-xs md:text-sm bg-black/30 rounded py-1 md:py-2 mb-2 md:mb-3">
                            ⏱️ <%= elapsed %>m
                        </div>
                        <% if (table.status === 'busy' || table.status === 'served') { %>
                            <a href="/waiter/order/dine-in/<%= table.tableNumber %>"
                               class="block bg-white text-orange-700 font-bold py-2 md:py-3 text-sm md:text-lg rounded-lg hover:bg-gray-100 mb-2">
                                Modify/Finish
                            </a>
                            <button onclick="showMoveOrderModal('<%= table.currentOrderId._id %>', 'dine-in', <%= table.tableNumber %>)"
                               class="block w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 md:py-3 text-sm md:text-lg rounded-lg mb-2">
                                Move
                            </button>
                        <% } %>
                        <% if (table.currentOrderId && table.currentOrderId.items) { %>
                            <div class="text-xs bg-black/30 rounded py-2 px-2 mb-2 max-h-32 overflow-y-auto">
                                <% table.currentOrderId.items.forEach((item, index) => {
                                    let statusIcon = '⏳';
                                    let statusColor = 'text-red-300';
                                    let statusText = 'Pending';
                                   
                                    if (item.status === 'preparing') {
                                        statusIcon = '🔥';
                                        statusColor = 'text-yellow-300';
                                        statusText = 'Preparing';
                                    } else if (item.status === 'ready') {
                                        statusIcon = '✓';
                                        statusColor = 'text-green-300';
                                        statusText = 'Ready';
                                    } else if (item.status === 'served') {
                                        statusIcon = '✓✓';
                                        statusColor = 'text-blue-300';
                                        statusText = 'Served';
                                    }
                                %>
                                    <div class="flex justify-between items-center mb-1 p-1">
                                        <span class="<%= statusColor %> flex-1"><%= statusIcon %> <%= item.name %> x<%= item.quantity %></span>
                                        <span class="<%= statusColor %> text-xs font-semibold"><%= statusText %></span>
                                        <% if (item.status === 'pending') { %>
                                            <button onclick="removeItem('<%= table.currentOrderId._id %>', <%= index %>)"
                                                class="bg-red-600 hover:bg-red-700 text-white text-xs px-2 py-1 rounded ml-2">
                                                ×
                                            </button>
                                        <% } else if (item.status === 'ready') { %>
                                            <button onclick="serveItem('<%= table.currentOrderId._id %>', <%= index %>)"
                                                class="bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded ml-2">
                                                Serve
                                            </button>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                        <% if ((table.status === 'billing' || table.status === 'served') && table.currentOrderId) { %>
                            <button onclick="showBillDetailsById('<%= table.currentOrderId._id %>', this)"
                                class="block w-full bg-white text-blue-700 font-bold py-2 md:py-3 text-sm md:text-lg rounded-lg hover:bg-gray-100">
                                <span class="btn-text">Bill</span>
                                <span class="btn-spinner hidden spinner">⚙️</span>
                            </button>
                        <% } %>
                    <% } %>
                </div>
            <% }); %>
        </div>
        </div>


        <!-- View All Orders Tab -->
        <div id="sectionOrders" class="hidden">
            <!-- Date Filter -->
            <div class="bg-gray-800 rounded-xl p-4 mb-4">
                <form method="GET" action="/waiter/dashboard" class="flex flex-col md:flex-row gap-3 md:items-end" id="filterForm">
                    <input type="hidden" name="tab" value="orders">
                    <div class="flex-1">
                        <label class="block text-gray-300 font-semibold mb-2 text-sm">From Date</label>
                        <input type="date" name="from" value="<%= from %>" 
                            class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm">
                    </div>
                    <div class="flex-1">
                        <label class="block text-gray-300 font-semibold mb-2 text-sm">To Date</label>
                        <input type="date" name="to" value="<%= to %>" 
                            class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm">
                    </div>
                    <div class="flex-1">
                        <label class="block text-gray-300 font-semibold mb-2 text-sm">Order Type</label>
                        <select name="orderType" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm">
                            <option value="all" <%= orderType === 'all' ? 'selected' : '' %>>All Orders</option>
                            <option value="dine-in" <%= orderType === 'dine-in' ? 'selected' : '' %>>Dine-in Only</option>
                            <option value="parcel" <%= orderType === 'parcel' ? 'selected' : '' %>>Parcel Only</option>
                            <option value="hall" <%= orderType === 'hall' ? 'selected' : '' %>>Hall Bookings Only</option>
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button type="submit" class="bg-sky-600 hover:bg-sky-700 px-4 py-2 rounded-lg font-bold text-sm">
                            Filter
                        </button>
                        <% if (currentView === 'today') { %>
                            <a href="/waiter/dashboard?view=yesterday&tab=orders" class="bg-orange-600 hover:bg-orange-700 px-4 py-2 rounded-lg font-bold text-sm">
                                Yesterday
                            </a>
                        <% } else { %>
                            <a href="/waiter/dashboard?tab=orders" class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg font-bold text-sm">
                                Today
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>
            
            <div class="bg-gray-800 rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-900">
                            <tr>
                                <th class="px-3 py-2 text-left text-xs">Order ID</th>
                                <th class="px-3 py-2 text-left text-xs">Type</th>
                                <th class="px-3 py-2 text-left text-xs">Table/Phone</th>
                                <th class="px-3 py-2 text-left text-xs">Amount</th>
                                <th class="px-3 py-2 text-left text-xs">Status</th>
                                <th class="px-3 py-2 text-left text-xs">Time</th>
                                <th class="px-3 py-2 text-left text-xs">Bill</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (allOrders.length === 0 && billedHallBookings.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                                        No orders today
                                    </td>
                                </tr>
                            <% } else { %>
                                <!-- Hall Bookings -->
                                <% billedHallBookings.forEach(booking => { %>
                                    <tr class="border-t border-gray-700 hover:bg-gray-900 bg-pink-900/10">
                                        <td class="px-3 py-2 font-bold text-xs"><%= booking.bookingId %></td>
                                        <td class="px-3 py-2">
                                            <span class="bg-pink-500/20 text-pink-400 px-2 py-1 rounded text-xs">Hall</span>
                                        </td>
                                        <td class="px-3 py-2 text-xs"><%= booking.hallId.name %></td>
                                        <td class="px-3 py-2 font-bold text-orange-500 text-xs">₹<%= booking.finalAmount %></td>
                                        <td class="px-3 py-2 text-blue-400 font-semibold text-xs">Billed</td>
                                        <td class="px-3 py-2 text-xs text-gray-400">
                                            <%= new Date(booking.bookingDate).toLocaleDateString('en-GB') %><br>
                                            <%= format12Hour(booking.endTime) %>
                                        </td>
                                        <td class="px-3 py-2">
                                            <% if (billMap['hall_' + booking._id.toString()]) { %>
                                                <a href="/admin/bill/<%= billMap['hall_' + booking._id.toString()] %>/view" target="_blank"
                                                   class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded text-xs font-bold">
                                                    View
                                                </a>
                                            <% } else { %>
                                                <span class="text-gray-600 text-xs">-</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                                
                                <!-- Regular Orders -->
                                <% allOrders.forEach(order => { 
                                    let statusColor = 'text-yellow-400';
                                    if (order.status === 'served') statusColor = 'text-green-400';
                                    if (order.status === 'billed') statusColor = 'text-blue-400';
                                %>
                                    <tr class="border-t border-gray-700 hover:bg-gray-900">
                                        <td class="px-3 py-2 font-bold text-xs"><%= order.orderId %></td>
                                        <td class="px-3 py-2">
                                            <% if (order.orderType === 'dine-in') { %>
                                                <span class="bg-orange-500/20 text-orange-400 px-2 py-1 rounded text-xs">Dine-in</span>
                                            <% } else if (order.orderType === 'parcel') { %>
                                                <span class="bg-purple-500/20 text-purple-400 px-2 py-1 rounded text-xs">Parcel</span>
                                            <% } %>
                                        </td>
                                        <td class="px-3 py-2 text-xs">
                                            <% if (order.orderType === 'dine-in') { %>
                                                Table <%= order.tableNumber %>
                                            <% } else { %>
                                                <%= order.customerPhone || 'N/A' %>
                                            <% } %>
                                        </td>
                                        <td class="px-3 py-2 font-bold text-orange-500 text-xs">
                                            <% if (order.status === 'billed' && billAmountMap[order._id.toString()]) { %>
                                                ₹<%= billAmountMap[order._id.toString()].toFixed(2) %>
                                            <% } else { %>
                                                ₹<%= order.totalAmount %>
                                            <% } %>
                                        </td>
                                        <td class="px-3 py-2 <%= statusColor %> font-semibold text-xs"><%= order.status %></td>
                                        <td class="px-3 py-2 text-xs text-gray-400">
                                            <%= new Date(order.orderTakenAt).toLocaleDateString('en-GB') %><br>
                                            <%= new Date(order.orderTakenAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) %>
                                        </td>
                                        <td class="px-3 py-2">
                                            <% if (billMap[order._id.toString()]) { %>
                                                <a href="/admin/bill/<%= billMap[order._id.toString()] %>/view" target="_blank"
                                                   class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded text-xs font-bold">
                                                    View
                                                </a>
                                            <% } else { %>
                                                <span class="text-gray-600 text-xs">-</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Hall Bookings Tab -->
        <div id="sectionHalls" class="hidden">
            <div class="mb-4 md:mb-6">
                <div class="flex justify-between items-center mb-3 md:mb-4">
                    <h2 class="text-2xl md:text-3xl font-bold">Hall Bookings</h2>
                    <a href="/hall/bookings/new" class="bg-green-600 hover:bg-green-700 px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold text-sm md:text-base">
                        + New
                    </a>
                </div>
                <% if (hallBookings.length === 0) { %>
                    <div class="text-center py-8 md:py-12 bg-gray-800 rounded-xl">
                        <div class="text-4xl md:text-6xl mb-3 md:mb-4">📅</div>
                        <div class="text-lg md:text-2xl font-bold text-gray-400">No upcoming bookings</div>
                    </div>
                <% } else { %>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
                        <% hallBookings.forEach(booking => {
                            const bookingDate = new Date(booking.bookingDate);
                            const today = new Date();
                            today.setHours(0, 0, 0, 0);
                            const isToday = bookingDate.toDateString() === today.toDateString();
                            const bgColor = isToday ? 'from-orange-500 to-orange-600' : 'from-blue-500 to-blue-600';
                        %>
                            <div class="bg-gradient-to-br <%= bgColor %> rounded-xl p-4 md:p-6 shadow-lg">
                                <div class="flex justify-between items-start mb-3 md:mb-4">
                                    <div>
                                        <div class="text-xl md:text-2xl font-bold"><%= booking.hallId.name %></div>
                                        <div class="text-xs md:text-sm bg-black/30 rounded px-2 py-1 inline-block mt-1">
                                            <%= isToday ? '🔥 Today' : '📅 ' + bookingDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                        </div>
                                    </div>
                                    <div class="text-xs bg-black/30 rounded px-2 py-1">
                                        <%= booking.bookingId %>
                                    </div>
                                </div>
                                <div class="bg-black/30 rounded p-2 md:p-3 mb-3 md:mb-4 space-y-1 md:space-y-2 text-xs md:text-sm">
                                    <div><strong>Customer:</strong> <%= booking.customerName %></div>
                                    <div><strong>Phone:</strong> <%= booking.customerPhone %></div>
                                    <div><strong>Time:</strong> 
                                        <% 
                                            const fmt = (t) => { if(!t) return ''; const [h,m]=t.split(':'); const hr=parseInt(h); return (hr%12||12)+':'+m+(hr>=12?' PM':' AM'); };
                                        %>
                                        <%= fmt(booking.startTime) %> - <%= fmt(booking.endTime) %>
                                    </div>
                                </div>
                                <a href="/hall/bookings/<%= booking._id %>" 
                                   class="block w-full bg-white text-center font-bold py-2 md:py-3 text-sm md:text-base rounded-lg hover:bg-gray-100"
                                   style="color: <%= isToday ? '#ea580c' : '#2563eb' %>">
                                    View Details
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>


    <!-- Pending Orders Modal -->
    <div id="pendingModal" class="hidden fixed inset-0 bg-black/90 z-50 overflow-y-auto p-4">
        <div class="max-w-7xl mx-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-3xl font-bold text-white">⏳ Pending Orders</h2>
                <button onclick="closePendingModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-lg text-xl">
                    ✕ Close
                </button>
            </div>
            <% if (pendingOrders.length === 0) { %>
                <div class="text-center text-gray-400 py-12">
                    <div class="text-6xl mb-4">✓</div>
                    <div class="text-2xl font-bold">No Pending Orders</div>
                </div>
            <% } else { %>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% pendingOrders.forEach(order => { %>
                        <div class="bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl p-6 shadow-lg animate-pulse-border">
                            <div class="flex justify-between items-start mb-4">
                                <div>
                                    <div class="text-2xl font-bold">Table <%= order.tableNumber %></div>
                                    <div class="text-sm bg-black/30 rounded px-2 py-1 inline-block mt-1">Customer Order</div>
                                </div>
                                <div class="text-xs bg-black/30 rounded px-2 py-1">⏱️ <%= Math.floor((Date.now() - new Date(order.orderTakenAt)) / 60000) %> min ago</div>
                            </div>
                            <div class="bg-black/30 rounded p-3 mb-4 max-h-40 overflow-y-auto">
                                <% 
                                const unapprovedItems = order.items.filter(item => !item.approved);
                                if (unapprovedItems.length > 0) {
                                    unapprovedItems.forEach(item => { %>
                                        <div class="mb-2">
                                            <div class="font-bold"><%= item.name %></div>
                                            <div class="text-sm">₹<%= item.price %> × <%= item.quantity %> = ₹<%= item.price * item.quantity %></div>
                                        </div>
                                    <% });
                                } else { %>
                                    <div class="text-sm text-gray-400">No new items</div>
                                <% } %>
                            </div>
                            <% 
                            const unapprovedTotal = order.items
                                .filter(item => !item.approved)
                                .reduce((sum, item) => sum + (item.price * item.quantity), 0);
                            %>
                            <div class="text-xl font-bold mb-4">New Items Total: ₹<%= unapprovedTotal %></div>
                            <% if (order.items.some(item => item.approved)) { %>
                                <div class="text-sm text-gray-400 mb-2">(Previous items already approved)</div>
                            <% } %>
                            <div class="flex gap-2">
                                <button onclick="approveOrder('<%= order._id %>', this)" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg">
                                    <span class="btn-text">✓ Approve</span>
                                    <span class="btn-spinner hidden spinner">⚙️</span>
                                </button>
                                <button onclick="rejectOrder('<%= order._id %>', this)" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg">
                                    <span class="btn-text">× Reject</span>
                                    <span class="btn-spinner hidden spinner">⚙️</span>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>


    <!-- Reject Reason Modal -->
    <div id="rejectModal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 rounded-xl max-w-md w-full p-6">
            <h3 class="text-2xl font-bold mb-4">Reject Order</h3>
            <textarea id="rejectReason" class="w-full bg-gray-800 text-white rounded-lg p-3 mb-4" rows="3" placeholder="Reason for rejection..."></textarea>
            <div class="flex gap-3">
                <button onclick="closeRejectModal()" class="flex-1 bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold">Cancel</button>
                <button onclick="confirmReject(this)" class="flex-1 bg-red-600 hover:bg-red-700 py-3 rounded-lg font-bold">
                    <span class="btn-text">Confirm Reject</span>
                    <span class="btn-spinner hidden spinner">⚙️</span>
                </button>
            </div>
        </div>
    </div>


    <!-- Bill Details Modal -->
    <div id="billModal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
        <div class="bg-gray-900 rounded-xl max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-4 rounded-t-xl">
                <h2 class="text-2xl font-bold text-white">Bill Details</h2>
            </div>
            <div class="p-6">
                <div id="billItems" class="space-y-2 mb-4"></div>
                <div class="border-t border-gray-700 pt-4 space-y-2">
                    <div class="flex justify-between text-gray-300">
                        <span>Food Subtotal:</span>
                        <span id="billSubtotal"></span>
                    </div>
                    <div class="flex justify-between text-gray-300">
                        <span>CGST (5%):</span>
                        <span id="billCGST"></span>
                    </div>
                    <div class="flex justify-between text-gray-300">
                        <span>SGST (5%):</span>
                        <span id="billSGST"></span>
                    </div>
                    <div class="border-t border-gray-700 pt-2 mt-2">
                        <label class="block text-gray-300 text-sm mb-2">Other Charges (₹)</label>
                        <div class="flex gap-2">
                            <input type="number" id="otherCharges" value="0" min="0" step="0.01"
                                class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white">
                            <button onclick="saveOtherCharges()" 
                                class="bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg whitespace-nowrap">
                                Save
                            </button>
                        </div>
                    </div>
                    <div class="flex justify-between text-2xl font-bold text-orange-500 border-t border-gray-700 pt-2 mt-2">
                        <span>Grand Total:</span>
                        <span id="billTotal"></span>
                    </div>
                </div>
                <div class="mt-6 space-y-3">
                    <button onclick="payBillFromModal('cash', this)"
                        class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg">
                        <span class="btn-text">💵 Pay by Cash</span>
                        <span class="btn-spinner hidden spinner">⚙️</span>
                    </button>
                    <button onclick="payBillFromModal('online', this)"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg">
                        <span class="btn-text">💳 Pay Online</span>
                        <span class="btn-spinner hidden spinner">⚙️</span>
                    </button>
                    <button onclick="closeBillModal()"
                        class="w-full bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 rounded-lg">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Move Order Modal -->
    <div id="moveOrderModal" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 rounded-xl max-w-md w-full p-6">
            <h3 class="text-2xl font-bold mb-4">Move Order</h3>
            <div id="moveOrderContent" class="space-y-4"></div>
            <div class="flex gap-3 mt-6">
                <button onclick="closeMoveOrderModal()" class="flex-1 bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold">Cancel</button>
                <button onclick="confirmMoveOrder(this)" class="flex-1 bg-purple-600 hover:bg-purple-700 py-3 rounded-lg font-bold">
                    <span class="btn-text">Confirm Move</span>
                    <span class="btn-spinner hidden spinner">⚙️</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentOrderId = null;
        let rejectOrderId = null;
        let rejectOrderBtn = null;
        
        // Load order data from global variable
        const orderDataMap = new Map();
        if (window.ORDER_DATA) {
            Object.keys(window.ORDER_DATA).forEach(key => {
                orderDataMap.set(key, window.ORDER_DATA[key]);
            });
        }


        async function showPendingModal(btn) {
            // Show loading state
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            // Fetch fresh pending orders
            try {
                console.log('Fetching pending orders...');
                const response = await fetch('/waiter/pending-orders-data');
                const data = await response.json();
                console.log('Pending orders data:', data);
                
                if (data.success) {
                    // Update modal content with fresh data
                    updatePendingModalContent(data.orders);
                } else {
                    console.error('Failed to fetch pending orders');
                    // Show empty state
                    updatePendingModalContent([]);
                }
            } catch (error) {
                console.error('Error fetching pending orders:', error);
                // Show empty state on error
                updatePendingModalContent([]);
            } finally {
                // Reset button state
                if (btn) {
                    btn.querySelector('.btn-text').classList.remove('hidden');
                    btn.querySelector('.btn-spinner').classList.add('hidden');
                    btn.disabled = false;
                }
            }
            
            document.getElementById('pendingModal').classList.remove('hidden');
        }
        
        function updatePendingModalContent(orders) {
            const modalContent = document.querySelector('#pendingModal .max-w-7xl');
            
            if (orders.length === 0) {
                modalContent.innerHTML = `
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-3xl font-bold text-white">⏳ Pending Orders</h2>
                        <button onclick="closePendingModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-lg text-xl">
                            ✕ Close
                        </button>
                    </div>
                    <div class="text-center text-gray-400 py-12">
                        <div class="text-6xl mb-4">✓</div>
                        <div class="text-2xl font-bold">No Pending Orders</div>
                    </div>
                `;
            } else {
                let ordersHtml = orders.map(order => {
                    const elapsed = Math.floor((Date.now() - new Date(order.orderTakenAt)) / 60000);
                    
                    // Filter only unapproved items
                    const unapprovedItems = order.items.filter(item => !item.approved);
                    const unapprovedTotal = unapprovedItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                    const hasApprovedItems = order.items.some(item => item.approved);
                    
                    const itemsHtml = unapprovedItems.map(item => `
                        <div class="mb-2">
                            <div class="font-bold">${item.name}</div>
                            <div class="text-sm">₹${item.price} × ${item.quantity} = ₹${item.price * item.quantity}</div>
                        </div>
                    `).join('');
                    
                    return `
                        <div class="bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl p-6 shadow-lg animate-pulse-border">
                            <div class="flex justify-between items-start mb-4">
                                <div>
                                    <div class="text-2xl font-bold">Table ${order.tableNumber}</div>
                                    <div class="text-sm bg-black/30 rounded px-2 py-1 inline-block mt-1">Customer Order</div>
                                </div>
                                <div class="text-xs bg-black/30 rounded px-2 py-1">⏱️ ${elapsed} min ago</div>
                            </div>
                            <div class="bg-black/30 rounded p-3 mb-4 max-h-40 overflow-y-auto">
                                ${itemsHtml || '<div class="text-sm text-gray-400">No new items</div>'}
                            </div>
                            <div class="text-xl font-bold mb-2">New Items Total: ₹${unapprovedTotal}</div>
                            ${hasApprovedItems ? '<div class="text-sm text-gray-400 mb-4">(Previous items already approved)</div>' : ''}
                            <div class="flex gap-2">
                                <button onclick="approveOrder('${order._id}', this)" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg">
                                    <span class="btn-text">✓ Approve</span>
                                    <span class="btn-spinner hidden spinner">⚙️</span>
                                </button>
                                <button onclick="rejectOrder('${order._id}', this)" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg">
                                    <span class="btn-text">× Reject</span>
                                    <span class="btn-spinner hidden spinner">⚙️</span>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
                
                modalContent.innerHTML = `
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-3xl font-bold text-white">⏳ Pending Orders</h2>
                        <button onclick="closePendingModal()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-lg text-xl">
                            ✕ Close
                        </button>
                    </div>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                        ${ordersHtml}
                    </div>
                `;
            }
        }


        function closePendingModal() {
            document.getElementById('pendingModal').classList.add('hidden');
        }


        function showTab(tab) {
            const active = 'px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold bg-orange-600 text-white whitespace-nowrap text-sm md:text-base';
            const inactive = 'px-4 py-2 md:px-6 md:py-3 rounded-lg font-bold bg-gray-700 text-white whitespace-nowrap text-sm md:text-base';
            
            document.getElementById('sectionMain').classList.toggle('hidden', tab !== 'main');
            document.getElementById('sectionOrders').classList.toggle('hidden', tab !== 'orders');
            document.getElementById('sectionHalls').classList.toggle('hidden', tab !== 'halls');
            document.getElementById('tabMain').className = tab === 'main' ? active : inactive;
            document.getElementById('tabOrders').className = tab === 'orders' ? active : inactive;
            document.getElementById('tabHalls').className = (tab === 'halls' ? active : inactive) + ' relative';
        }
        
        // Show orders tab if tab=orders in URL
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tab = urlParams.get('tab');
            if (tab === 'orders') {
                showTab('orders');
            }
        });


        function showBillDetailsById(orderId, btn) {
            console.log('showBillDetailsById called with orderId:', orderId);
            console.log('orderDataMap contents:', orderDataMap);
            const orderData = orderDataMap.get(orderId);
            if (!orderData) {
                console.error('Order data not found for orderId:', orderId);
                alert('Order data not found. Please refresh the page.');
                return;
            }
            showBillDetails(orderId, orderData.items, orderData.totalAmount, btn);
        }

        function showBillDetails(orderId, items, totalAmount, btn) {
            // Show loading state
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            currentOrderId = orderId;
            const CGST_RATE = <%= CGST_RATE %>;
            const SGST_RATE = <%= SGST_RATE %>;
            const totalTaxRate = 1 + CGST_RATE + SGST_RATE;
            const subtotal = totalAmount / totalTaxRate;
            const cgst = subtotal * CGST_RATE;
            const sgst = subtotal * SGST_RATE;
           
            let itemsHtml = items.map(item => `
                <div class="flex justify-between bg-gray-800 p-3 rounded-lg">
                    <div>
                        <div class="font-bold">${item.name}</div>
                        <div class="text-sm text-gray-400">₹${item.price} × ${item.quantity}</div>
                    </div>
                    <div class="font-bold">₹${item.price * item.quantity}</div>
                </div>
            `).join('');
           
            document.getElementById('billItems').innerHTML = itemsHtml;
            document.getElementById('billSubtotal').textContent = '₹' + subtotal.toFixed(2);
            document.getElementById('billCGST').textContent = '₹' + cgst.toFixed(2);
            document.getElementById('billSGST').textContent = '₹' + sgst.toFixed(2);
            document.getElementById('otherCharges').value = '0';
            document.getElementById('billTotal').textContent = '₹' + totalAmount;
            document.getElementById('billModal').classList.remove('hidden');
            
            // Reset button state
            if (btn) {
                btn.querySelector('.btn-text').classList.remove('hidden');
                btn.querySelector('.btn-spinner').classList.add('hidden');
                btn.disabled = false;
            }
        }


        function closeBillModal() {
            document.getElementById('billModal').classList.add('hidden');
            currentOrderId = null;
        }


        function saveOtherCharges() {
            const otherCharges = parseFloat(document.getElementById('otherCharges').value) || 0;
            const subtotal = parseFloat(document.getElementById('billSubtotal').textContent.replace('₹', ''));
            const cgst = parseFloat(document.getElementById('billCGST').textContent.replace('₹', ''));
            const sgst = parseFloat(document.getElementById('billSGST').textContent.replace('₹', ''));
            const grandTotal = subtotal + cgst + sgst + otherCharges;
            document.getElementById('billTotal').textContent = '₹' + grandTotal.toFixed(2);
            showToast('✅ Other charges saved!', 'success', 2000);
        }

        function payBillFromModal(paymentMethod, btn) {
            if (!currentOrderId) return;
            
            // Show loading state
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            const otherCharges = parseFloat(document.getElementById('otherCharges').value) || 0;
           
            fetch('/admin/bill/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId: currentOrderId, paymentMethod, otherCharges })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(`Payment received! Bill: ${data.billId}`);
                    location.reload();
                } else {
                    alert('Error: ' + (data.error || 'Unknown error'));
                    console.error('Bill generation failed:', data);
                }
            })
            .catch(err => {
                alert('Network error: ' + err.message);
                console.error('Network error:', err);
            });
        }


        function serveItem(orderId, itemIndex) {
            fetch(`/waiter/serve/${orderId}/${itemIndex}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) location.reload();
                });
        }


        function removeItem(orderId, itemIndex) {
            if (!confirm('Remove this item from order?')) return;
           
            fetch(`/waiter/remove/${orderId}/${itemIndex}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Cannot remove item');
                    }
                });
        }


        async function approveOrder(orderId, btn) {
            if (!confirm('Approve this order and send to kitchen?')) return;
            
            // Show loading state
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            try {
                const response = await fetch('/waiter/approve-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId })
                });
                const data = await response.json();
                
                if (data.success) {
                    // Remove the approved order card from DOM
                    const orderCard = btn.closest('.bg-gradient-to-br');
                    if (orderCard) {
                        orderCard.style.transition = 'opacity 0.3s, transform 0.3s';
                        orderCard.style.opacity = '0';
                        orderCard.style.transform = 'scale(0.9)';
                        setTimeout(() => orderCard.remove(), 300);
                    }
                    
                    // Update pending count
                    lastPendingCount--;
                    
                    // Fetch and update pending orders
                    const countResponse = await fetch('/waiter/pending-orders-data');
                    const countData = await countResponse.json();
                    if (countData.success) {
                        updatePendingModalContent(countData.orders);
                        
                        // Update badge
                        updatePendingBadge(countData.orders.length);
                        
                        // If no more pending orders, show success message and close modal
                        if (countData.orders.length === 0) {
                            showToast('✅ All orders approved!', 'success');
                            setTimeout(() => {
                                closePendingModal();
                                location.reload();
                            }, 1500);
                        } else {
                            showToast('✅ Order approved!', 'success');
                        }
                    }
                } else {
                    showToast('❌ ' + (data.error || 'Error approving order'), 'error');
                    // Reset button state
                    if (btn) {
                        btn.querySelector('.btn-text').classList.remove('hidden');
                        btn.querySelector('.btn-spinner').classList.add('hidden');
                        btn.disabled = false;
                    }
                }
            } catch (error) {
                showToast('❌ Network error', 'error');
                // Reset button state
                if (btn) {
                    btn.querySelector('.btn-text').classList.remove('hidden');
                    btn.querySelector('.btn-spinner').classList.add('hidden');
                    btn.disabled = false;
                }
            }
        }


        function rejectOrder(orderId, btn) {
            rejectOrderId = orderId;
            rejectOrderBtn = btn;
            document.getElementById('rejectModal').classList.remove('hidden');
        }


        function closeRejectModal() {
            document.getElementById('rejectModal').classList.add('hidden');
            rejectOrderId = null;
            document.getElementById('rejectReason').value = '';
        }


        async function confirmReject(btn) {
            const reason = document.getElementById('rejectReason').value.trim();
            if (!reason) {
                showToast('⚠️ Please provide a reason', 'error');
                return;
            }
            
            // Show loading state
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            try {
                const response = await fetch('/waiter/reject-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: rejectOrderId, reason })
                });
                const data = await response.json();
                
                if (data.success) {
                    // Remove the rejected order card from DOM
                    const orderCards = document.querySelectorAll('.bg-gradient-to-br.from-yellow-500');
                    orderCards.forEach(card => {
                        const approveBtn = card.querySelector('button[onclick*="approveOrder"]');
                        if (approveBtn && approveBtn.getAttribute('onclick').includes(rejectOrderId)) {
                            card.style.transition = 'opacity 0.3s, transform 0.3s';
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.9)';
                            setTimeout(() => card.remove(), 300);
                        }
                    });
                    
                    closeRejectModal();
                    
                    // Update pending count
                    lastPendingCount--;
                    
                    // Fetch and update pending orders
                    const countResponse = await fetch('/waiter/pending-orders-data');
                    const countData = await countResponse.json();
                    if (countData.success) {
                        updatePendingModalContent(countData.orders);
                        
                        // Update badge
                        updatePendingBadge(countData.orders.length);
                        
                        // If no more pending orders, show success message and close modal
                        if (countData.orders.length === 0) {
                            showToast('✅ All orders processed!', 'success');
                            setTimeout(() => {
                                closePendingModal();
                                location.reload();
                            }, 1500);
                        } else {
                            showToast('✅ Order rejected', 'success');
                        }
                    }
                } else {
                    showToast('❌ ' + (data.error || 'Error rejecting order'), 'error');
                    // Reset button state
                    if (btn) {
                        btn.querySelector('.btn-text').classList.remove('hidden');
                        btn.querySelector('.btn-spinner').classList.add('hidden');
                        btn.disabled = false;
                    }
                }
            } catch (error) {
                showToast('❌ Network error', 'error');
                // Reset button state
                if (btn) {
                    btn.querySelector('.btn-text').classList.remove('hidden');
                    btn.querySelector('.btn-spinner').classList.add('hidden');
                    btn.disabled = false;
                }
            }
        }


        // Check for pending orders every 2 seconds (faster polling)
        let lastPendingCount = <%= pendingOrders.length %>; // Initialize with current count
        
        function updatePendingBadge(count) {
            const badge = document.getElementById('pendingBadge');
            const btn = document.getElementById('pendingOrdersBtn');
            
            if (count > 0) {
                badge.textContent = count;
                badge.classList.remove('hidden');
                btn.classList.add('animate-pulse-border');
            } else {
                badge.classList.add('hidden');
                btn.classList.remove('animate-pulse-border');
            }
        }
        
        setInterval(async () => {
            try {
                const response = await fetch('/waiter/pending-count');
                const data = await response.json();
               
                if (data.count > lastPendingCount) {
                    // New pending order - show toast notification with sound
                    const newOrdersCount = data.count - lastPendingCount;
                    showToast(`🔔 ${newOrdersCount} new order${newOrdersCount > 1 ? 's' : ''} received!`, 'warning', 5000);
                    playNotificationSound();
                    
                    // Update badge
                    updatePendingBadge(data.count);
                    
                    lastPendingCount = data.count;
                } else if (data.count < lastPendingCount) {
                    // Order count decreased (approved/rejected elsewhere)
                    lastPendingCount = data.count;
                    
                    // Update badge
                    updatePendingBadge(data.count);
                }
            } catch (error) {
                console.error('Error checking pending orders:', error);
            }
        }, 2000); // Check every 2 seconds


        function playNotificationSound() {
            // Create audio context and play notification beep
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            // Set frequency and type for notification sound
            oscillator.frequency.value = 800; // Hz
            oscillator.type = 'sine';
            
            // Set volume
            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
            
            // Play sound
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.5);
            
            // Play 3 beeps
            setTimeout(() => {
                const osc2 = audioContext.createOscillator();
                const gain2 = audioContext.createGain();
                osc2.connect(gain2);
                gain2.connect(audioContext.destination);
                osc2.frequency.value = 1000;
                osc2.type = 'sine';
                gain2.gain.setValueAtTime(0.3, audioContext.currentTime);
                gain2.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
                osc2.start(audioContext.currentTime);
                osc2.stop(audioContext.currentTime + 0.5);
            }, 200);
            
            setTimeout(() => {
                const osc3 = audioContext.createOscillator();
                const gain3 = audioContext.createGain();
                osc3.connect(gain3);
                gain3.connect(audioContext.destination);
                osc3.frequency.value = 1200;
                osc3.type = 'sine';
                gain3.gain.setValueAtTime(0.3, audioContext.currentTime);
                gain3.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
                osc3.start(audioContext.currentTime);
                osc3.stop(audioContext.currentTime + 0.5);
            }, 400);
        }


        function showToast(message, type = 'info', duration = 3000) {
            // Remove existing toast if any
            const existingToast = document.getElementById('toastNotification');
            if (existingToast) {
                existingToast.remove();
            }
            
            // Determine colors based on type
            let bgColor = 'from-blue-500 to-blue-600';
            if (type === 'success') bgColor = 'from-green-500 to-green-600';
            if (type === 'error') bgColor = 'from-red-500 to-red-600';
            if (type === 'warning') bgColor = 'from-yellow-500 to-orange-600';
            
            // Create toast
            const toast = document.createElement('div');
            toast.id = 'toastNotification';
            toast.className = `toast-notification fixed top-4 left-1/2 transform -translate-x-1/2 z-50 bg-gradient-to-r ${bgColor} rounded-xl px-6 py-4 shadow-2xl max-w-md`;
            toast.innerHTML = `
                <div class="flex items-center gap-3">
                    <div class="text-2xl">${type === 'warning' ? '🔔' : ''}</div>
                    <p class="text-white font-bold text-lg flex-1">${message}</p>
                    <button onclick="this.parentElement.parentElement.remove()" class="text-white hover:text-gray-200 text-2xl font-bold">
                        ×
                    </button>
                </div>
            `;
            document.body.appendChild(toast);
            
            // Auto-dismiss after duration
            setTimeout(() => {
                if (toast && toast.parentElement) {
                    toast.classList.add('hiding');
                    setTimeout(() => toast.remove(), 500);
                }
            }, duration);
        }
        
        // Toggle QR ordering
        async function toggleQROrdering(btn) {
            if (!confirm('Toggle QR ordering status?')) return;
            
            // Show loading
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            try {
                const response = await fetch('/waiter/toggle-qr-ordering', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    alert(`QR Ordering ${data.enabled ? 'ENABLED' : 'DISABLED'}`);
                    location.reload();
                } else {
                    alert('Error: ' + (data.error || 'Unknown error'));
                    // Reset button
                    if (btn) {
                        btn.querySelector('.btn-text').classList.remove('hidden');
                        btn.querySelector('.btn-spinner').classList.add('hidden');
                        btn.disabled = false;
                    }
                }
            } catch (error) {
                alert('Network error: ' + error.message);
                // Reset button
                if (btn) {
                    btn.querySelector('.btn-text').classList.remove('hidden');
                    btn.querySelector('.btn-spinner').classList.add('hidden');
                    btn.disabled = false;
                }
            }
        }
        
        // Add loading overlay to navigation links
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('pageLoadingOverlay').classList.add('hidden');
            // Add loading overlay to all navigation links (except logout and refresh)
            document.querySelectorAll('a:not([href*="logout"]):not([onclick*="reload"])').forEach(link => {
                link.addEventListener('click', function(e) {
                    // Only show overlay for page navigation, not for modals or external links
                    if (!this.getAttribute('onclick') && !this.getAttribute('target')) {
                        document.getElementById('pageLoadingOverlay').classList.remove('hidden');
                    }
                });
            });
            
            // Add loading overlay to form submissions
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function() {
                    document.getElementById('pageLoadingOverlay').classList.remove('hidden');
                });
            });
        });
        window.addEventListener('pageshow', function(e) { if (e.persisted) document.getElementById('pageLoadingOverlay').classList.add('hidden'); });
        
        // Move Order functionality
        let moveOrderData = {};
        
        function showMoveOrderModal(orderId, currentType, currentTable) {
            console.log('showMoveOrderModal called with:', { orderId, currentType, currentTable });
            console.log('orderDataMap contents:', orderDataMap);
            moveOrderData = { orderId, currentType, currentTable };
            
            let content = '';
            if (currentType === 'dine-in') {
                content = `
                    <div class="bg-gray-800 p-4 rounded-lg mb-4">
                        <p class="text-gray-300 mb-2">Current: <span class="font-bold text-white">Table ${currentTable}</span></p>
                    </div>
                    <div class="space-y-3">
                        <button onclick="selectMoveType('table-to-table')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg text-left px-4">
                            Move to Another Table
                        </button>
                        <button onclick="selectMoveType('table-to-parcel')" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-lg text-left px-4">
                            Convert to Parcel
                        </button>
                    </div>
                `;
            } else if (currentType === 'parcel') {
                content = `
                    <div class="bg-gray-800 p-4 rounded-lg mb-4">
                        <p class="text-gray-300 mb-2">Current: <span class="font-bold text-white">Parcel Order</span></p>
                    </div>
                    <div class="space-y-3">
                        <button onclick="selectMoveType('parcel-to-table')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg text-left px-4">
                            Convert to Dine-in
                        </button>
                    </div>
                `;
            }
            
            document.getElementById('moveOrderContent').innerHTML = content;
            document.getElementById('moveOrderModal').classList.remove('hidden');
        }
        
        function selectMoveType(moveType) {
            moveOrderData.moveType = moveType;
            
            const contentDiv = document.getElementById('moveOrderContent');
            const tablesData = <%- JSON.stringify(tables.map(t => ({ number: t.tableNumber, status: t.status }))) %>;
            
            if (moveType === 'table-to-table') {
                const emptyTables = tablesData.filter(t => t.status === 'empty' && t.number !== moveOrderData.currentTable);
                
                if (emptyTables.length === 0) {
                    contentDiv.innerHTML = '<div class="bg-red-900/30 border border-red-500 p-4 rounded-lg text-center">' +
                        '<p class="text-red-400 font-bold">⚠️ No empty tables available</p>' +
                        '</div>';
                    
                    const backBtn = document.createElement('button');
                    backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold mt-4';
                    backBtn.textContent = '← Back';
                    backBtn.onclick = function() { showMoveOrderModal(moveOrderData.orderId, moveOrderData.currentType, moveOrderData.currentTable); };
                    contentDiv.appendChild(backBtn);
                } else {
                    contentDiv.innerHTML = '<div class="bg-gray-800 p-4 rounded-lg mb-4">' +
                        '<p class="text-gray-300">Select target table:</p>' +
                        '</div>' +
                        '<div id="tableButtonsGrid" class="grid grid-cols-3 gap-2 max-h-60 overflow-y-auto"></div>';
                    
                    const grid = document.getElementById('tableButtonsGrid');
                    emptyTables.forEach(t => {
                        const btn = document.createElement('button');
                        btn.className = 'bg-green-600 hover:bg-green-700 text-white font-bold py-4 rounded-lg';
                        btn.textContent = 'T' + t.number;
                        btn.onclick = function() { selectTable(t.number); };
                        grid.appendChild(btn);
                    });
                    
                    const backBtn = document.createElement('button');
                    backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold mt-4';
                    backBtn.textContent = '← Back';
                    backBtn.onclick = function() { showMoveOrderModal(moveOrderData.orderId, moveOrderData.currentType, moveOrderData.currentTable); };
                    contentDiv.appendChild(backBtn);
                }
            } else if (moveType === 'parcel-to-table') {
                const emptyTables = tablesData.filter(t => t.status === 'empty');
                
                if (emptyTables.length === 0) {
                    contentDiv.innerHTML = '<div class="bg-red-900/30 border border-red-500 p-4 rounded-lg text-center">' +
                        '<p class="text-red-400 font-bold">⚠️ No empty tables available</p>' +
                        '</div>';
                    
                    const backBtn = document.createElement('button');
                    backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold mt-4';
                    backBtn.textContent = '← Back';
                    backBtn.onclick = function() { showMoveOrderModal(moveOrderData.orderId, moveOrderData.currentType, moveOrderData.currentTable); };
                    contentDiv.appendChild(backBtn);
                } else {
                    contentDiv.innerHTML = '<div class="bg-gray-800 p-4 rounded-lg mb-4">' +
                        '<p class="text-gray-300">Select table:</p>' +
                        '</div>' +
                        '<div id="tableButtonsGrid" class="grid grid-cols-3 gap-2 max-h-60 overflow-y-auto"></div>';
                    
                    const grid = document.getElementById('tableButtonsGrid');
                    emptyTables.forEach(t => {
                        const btn = document.createElement('button');
                        btn.className = 'bg-green-600 hover:bg-green-700 text-white font-bold py-4 rounded-lg';
                        btn.textContent = 'T' + t.number;
                        btn.onclick = function() { selectTable(t.number); };
                        grid.appendChild(btn);
                    });
                    
                    const backBtn = document.createElement('button');
                    backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold mt-4';
                    backBtn.textContent = '← Back';
                    backBtn.onclick = function() { showMoveOrderModal(moveOrderData.orderId, moveOrderData.currentType, moveOrderData.currentTable); };
                    contentDiv.appendChild(backBtn);
                }
            } else if (moveType === 'table-to-parcel') {
                contentDiv.innerHTML = '<div class="bg-gray-800 p-4 rounded-lg mb-4">' +
                    '<p class="text-gray-300 mb-2">Convert Table ' + moveOrderData.currentTable + ' order to Parcel?</p>' +
                    '<p class="text-sm text-gray-400">The order will be moved to parcel orders section.</p>' +
                    '</div>';
                
                const backBtn = document.createElement('button');
                backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold';
                backBtn.textContent = '← Back';
                backBtn.onclick = function() { showMoveOrderModal(moveOrderData.orderId, moveOrderData.currentType, moveOrderData.currentTable); };
                contentDiv.appendChild(backBtn);
            }
        }
        
        function selectTable(tableNumber) {
            moveOrderData.newTableNumber = tableNumber;
            
            const backBtn = document.createElement('button');
            backBtn.className = 'w-full bg-gray-700 hover:bg-gray-600 py-3 rounded-lg font-bold';
            backBtn.textContent = '← Back';
            backBtn.onclick = function() { selectMoveType(moveOrderData.moveType); };
            
            const content = '<div class="bg-gray-800 p-4 rounded-lg mb-4">' +
                '<p class="text-gray-300 mb-2">Move order:</p>' +
                '<p class="text-xl font-bold text-white">' +
                    (moveOrderData.currentType === 'dine-in' ? 'Table ' + moveOrderData.currentTable : 'Parcel') + ' ' +
                    '→ Table ' + tableNumber +
                '</p>' +
                '</div>';
            
            document.getElementById('moveOrderContent').innerHTML = content;
            document.getElementById('moveOrderContent').appendChild(backBtn);
        }
        
        function closeMoveOrderModal() {
            document.getElementById('moveOrderModal').classList.add('hidden');
            moveOrderData = {};
        }
        
        async function confirmMoveOrder(btn) {
            if (!moveOrderData.moveType) {
                alert('Please select a move option');
                return;
            }
            
            if ((moveOrderData.moveType === 'table-to-table' || moveOrderData.moveType === 'parcel-to-table') && !moveOrderData.newTableNumber) {
                alert('Please select a table');
                return;
            }
            
            if (!confirm('Confirm move order?')) return;
            
            // Show loading
            if (btn) {
                btn.querySelector('.btn-text').classList.add('hidden');
                btn.querySelector('.btn-spinner').classList.remove('hidden');
                btn.disabled = true;
            }
            
            try {
                const response = await fetch('/waiter/move-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(moveOrderData)
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast('✅ Order moved successfully!', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('Error: ' + (data.error || 'Unknown error'));
                    if (btn) {
                        btn.querySelector('.btn-text').classList.remove('hidden');
                        btn.querySelector('.btn-spinner').classList.add('hidden');
                        btn.disabled = false;
                    }
                }
            } catch (error) {
                alert('Network error: ' + error.message);
                if (btn) {
                    btn.querySelector('.btn-text').classList.remove('hidden');
                    btn.querySelector('.btn-spinner').classList.add('hidden');
                    btn.disabled = false;
                }
            }
        }
    </script>
