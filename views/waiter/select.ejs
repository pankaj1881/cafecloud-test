<!DOCTYPE html>
<html>
<head>
    <title>Select Waiter - Cafe Cloud</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen flex items-center justify-center">
    <div class="max-w-2xl w-full mx-4">
        <div class="text-center mb-8">
            <h1 class="text-5xl font-bold mb-2">
                <span class="text-sky-400">Select</span> <span class="text-orange-500">Waiter</span>
            </h1>
            <p class="text-gray-400">Choose your name to continue</p>
        </div>
        
        <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-8 border border-gray-700">
            <% if (waiters.length === 0) { %>
                <div class="text-center py-8">
                    <p class="text-gray-400 mb-4">No waiters available. Please contact admin.</p>
                    <a href="/" class="text-sky-400 hover:text-sky-300">← Back to Home</a>
                </div>
            <% } else { %>
                <div class="grid md:grid-cols-2 gap-4">
                    <% waiters.forEach(waiter => { %>
                        <a href="/waiter/dashboard/<%= encodeURIComponent(waiter.name) %>" 
                           class="bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold py-6 rounded-xl text-center text-xl transition-all transform hover:scale-105 shadow-lg">
                            <%= waiter.name %>
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </div>
        
        <div class="text-center mt-6">
            <a href="/" class="text-gray-400 hover:text-sky-400">← Back to Home</a>
        </div>
    </div>
</body>
</html>
