<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Dashboard - Cafe Cloud</title>
    <%- include("../partials/favicon") %>
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#f97316">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logo.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spinner {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
    </style>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen">
    <!-- Global Loading Overlay -->
    <div id="pageLoadingOverlay" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center">
        <div class="text-center">
            <div class="text-6xl mb-4 spinner">⚙️</div>
            <div class="text-2xl font-bold text-white">Loading...</div>
        </div>
    </div>
    
    <nav class="bg-gray-900 border-b border-gray-800 p-4">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">
                <span class="text-sky-400">Kitchen</span> <span class="text-orange-500">Dashboard</span>
            </h1>
            <a href="/waiter/dashboard" class="bg-green-600 hover:bg-green-700 px-6 py-3 text-lg font-bold rounded-lg">Orders</a>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <% if (orders.length === 0) { %>
            <div class="text-center py-20">
                <div class="text-6xl mb-4">✅</div>
                <h2 class="text-2xl font-bold text-gray-400">No pending orders</h2>
            </div>
        <% } else { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                <% orders.forEach(order => { 
                    let bgColor = 'from-yellow-500 to-yellow-600';
                    let statusText = 'Pending';
                    let actionBtn = '';
                    
                    if (order.status === 'pending') {
                        bgColor = 'from-red-500 to-red-600';
                        statusText = 'NEW ORDER';
                        actionBtn = `<button onclick="startPreparing('${order._id}', null, this)" 
                            class="w-full bg-white text-red-700 font-bold py-3 text-base md:text-lg rounded-lg hover:bg-gray-100">
                            <span class="btn-text">Start Preparing</span>
                            <span class="btn-spinner hidden spinner">⚙️</span>
                        </button>`;
                    } else if (order.status === 'preparing') {
                        bgColor = 'from-yellow-500 to-yellow-600';
                        statusText = 'PREPARING';
                        actionBtn = `<button onclick="markReady('${order._id}', null, this)" 
                            class="w-full bg-white text-yellow-700 font-bold py-3 text-base md:text-lg rounded-lg hover:bg-gray-100">
                            <span class="btn-text">Mark Ready</span>
                            <span class="btn-spinner hidden spinner">⚙️</span>
                        </button>`;
                    } else if (order.status === 'ready') {
                        bgColor = 'from-green-500 to-green-600';
                        statusText = 'READY';
                        actionBtn = `<div class="text-center text-white font-bold py-3 text-sm md:text-base">Waiting for waiter...</div>`;
                    }
                    
                    const elapsed = Math.floor((Date.now() - new Date(order.orderTakenAt)) / 60000);
                %>
                    <div class="bg-gradient-to-br <%= bgColor %> rounded-xl p-4 md:p-6 shadow-lg">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <div class="text-2xl md:text-3xl font-bold"><%= order.orderId %></div>
                                <div class="text-base md:text-lg font-semibold"><%= statusText %></div>
                            </div>
                            <div class="text-right">
                                <% if (order.orderType === 'dine-in') { %>
                                    <div class="text-3xl md:text-4xl font-bold">T<%= order.tableNumber %></div>
                                <% } else if (order.orderType === 'hall') { %>
                                    <div class="text-3xl md:text-4xl">🏛️</div>
                                    <div class="text-xs md:text-sm">Hall</div>
                                    <% if (order.hallBookingId) { %>
                                        <div class="text-xs"><%= order.hallBookingId.bookingId %></div>
                                    <% } %>
                                <% } else { %>
                                    <div class="text-3xl md:text-4xl">📦</div>
                                    <div class="text-xs md:text-sm">Parcel</div>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="bg-black/30 rounded-lg p-3 md:p-4 mb-4">
                            <div class="font-semibold mb-2 text-base md:text-lg">Items:</div>
                            <% order.items.forEach((item, index) => { 
                                let itemColor = 'text-white';
                                let itemBg = 'bg-red-600/20';
                                let actionBtn = '';
                                
                                if (item.status === 'pending') {
                                    itemColor = 'text-red-300';
                                    itemBg = 'bg-red-600/20';
                                    actionBtn = `<button onclick="startPreparing('${order._id}', ${index}, this)" class="text-xs md:text-sm bg-yellow-600 hover:bg-yellow-700 px-2 md:px-3 py-1 rounded font-bold"><span class="btn-text">Start</span><span class="btn-spinner hidden spinner">⚙️</span></button>`;
                                } else if (item.status === 'preparing') {
                                    itemColor = 'text-yellow-300';
                                    itemBg = 'bg-yellow-600/20';
                                    actionBtn = `<button onclick="markReady('${order._id}', ${index}, this)" class="text-xs md:text-sm bg-green-600 hover:bg-green-700 px-2 md:px-3 py-1 rounded font-bold"><span class="btn-text">Ready</span><span class="btn-spinner hidden spinner">⚙️</span></button>`;
                                } else if (item.status === 'ready') {
                                    itemColor = 'text-green-300';
                                    itemBg = 'bg-green-600/20';
                                    actionBtn = '<span class="text-xs md:text-sm text-green-400 font-bold">✓ Ready</span>';
                                } else if (item.status === 'served') {
                                    itemColor = 'text-blue-300';
                                    itemBg = 'bg-blue-600/20';
                                    actionBtn = '<span class="text-xs md:text-sm text-blue-400 font-bold">✓ Served</span>';
                                }
                            %>
                                <div class="flex justify-between items-center text-sm md:text-base mb-2 p-2 rounded <%= itemBg %>">
                                    <span class="<%= itemColor %> font-semibold flex items-center gap-1 md:gap-2 flex-1 min-w-0">
                                        <% if (item.foodType === 'veg') { %>
                                            <span class="text-green-400 text-sm">🟢</span>
                                        <% } else if (item.foodType === 'non-veg') { %>
                                            <span class="text-red-400 text-sm">🔴</span>
                                        <% } else if (item.foodType === 'beverage') { %>
                                            <span class="text-yellow-400 text-sm">🟡</span>
                                        <% } else if (item.foodType === 'other') { %>
                                            <span class="text-gray-400 text-sm">⚪</span>
                                        <% } %>
                                        <span class="truncate"><%= item.name %> x<%= item.quantity %></span>
                                    </span>
                                    <span class="flex-shrink-0 ml-2"><%- actionBtn %></span>
                                </div>
                            <% }); %>
                        </div>
                        
                        <div class="text-sm md:text-base mb-3 font-semibold">
                            ⏱️ <%= elapsed %> min ago
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <script>
        function startPreparing(orderId, itemIndex, btn) {
            if (btn) {
                const textEl = btn.querySelector('.btn-text');
                const spinnerEl = btn.querySelector('.btn-spinner');
                if (textEl && spinnerEl) {
                    textEl.classList.add('hidden');
                    spinnerEl.classList.remove('hidden');
                }
                btn.disabled = true;
            }
            
            fetch(`/kitchen/prepare/${orderId}/${itemIndex}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) location.reload();
                });
        }

        function markReady(orderId, itemIndex, btn) {
            if (btn) {
                const textEl = btn.querySelector('.btn-text');
                const spinnerEl = btn.querySelector('.btn-spinner');
                if (textEl && spinnerEl) {
                    textEl.classList.add('hidden');
                    spinnerEl.classList.remove('hidden');
                }
                btn.disabled = true;
            }
            
            fetch(`/kitchen/ready/${orderId}/${itemIndex}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) location.reload();
                });
        }

        // Auto refresh every 20 seconds
        setTimeout(() => location.reload(), 20000);
        
        // Add loading overlay to navigation links
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('pageLoadingOverlay').classList.add('hidden');
            document.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    document.getElementById('pageLoadingOverlay').classList.remove('hidden');
                });
            });
        });
        window.addEventListener('pageshow', function(e) { if (e.persisted) document.getElementById('pageLoadingOverlay').classList.add('hidden'); });
    </script>
</body>
</html>
