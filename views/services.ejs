<!DOCTYPE html>
<html>
<head>
    <title>Our Services - <%= settings?.cafeName || 'Cafe Cloud' %></title>
    <%- include("./partials/favicon") %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gradient-text {
            background: linear-gradient(135deg, #38bdf8 0%, #fb923c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .card-hover {
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .card-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }
        .platform-btn {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .platform-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }
        @keyframes scrollHall {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .hall-scroll { animation: scrollHall 25s linear infinite; }
        .hall-scroll:hover { animation-play-state: paused; }
    </style>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen">

<%- include("partials/navbar") %>

<!-- Hero Section -->
<section class="py-20 px-6 text-center">
    <h1 class="text-5xl md:text-7xl font-extrabold mb-4 gradient-text">Our Services</h1>
    <div class="w-32 h-1 bg-gradient-to-r from-sky-400 to-orange-500 mx-auto mb-6 rounded-full"></div>
    <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto">Making your dining experience seamless — order online, dine smart, or host your events with us.</p>
</section>

<!-- Section 1: Order Online -->
<section class="px-6 pb-20 max-w-6xl mx-auto">
    <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 rounded-2xl p-8 md:p-12 border border-gray-700/50 card-hover">
        <div class="text-center mb-10">
            <div class="text-5xl mb-4">🛍️</div>
            <h2 class="text-3xl md:text-4xl font-bold mb-3">Order <span class="text-orange-400">Online</span></h2>
            <p class="text-gray-400 text-lg">Craving something delicious? Order from your favourite platform and get it delivered!</p>
        </div>

        <div class="flex flex-wrap justify-center gap-6 max-w-3xl mx-auto">
            <% deliveryPartners.forEach(partner => { %>
            <a href="<%= partner.url %>" target="_blank" class="platform-btn flex flex-col items-center gap-3 bg-gray-800 rounded-xl p-6 border border-gray-700 hover:border-orange-500 w-48">
                <img src="<%= getImageUrl(partner.logo, 'menu-images') %>" alt="<%= partner.name %>" class="h-14 w-14 object-contain">
                <span class="font-bold text-lg"><%= partner.name %></span>
                <span class="text-xs text-gray-400">Order Now →</span>
            </a>
            <% }); %>
        </div>

        <% if (deliveryPartners.length === 0) { %>
        <p class="text-center text-gray-500 mt-4">Online ordering platforms coming soon!</p>
        <% } %>

        <div class="text-center mt-8 pt-6 border-t border-gray-700/50">
            <p class="text-gray-400">Prefer takeaway? Visit us and order at the counter!</p>
            <a href="/menu" class="inline-block mt-3 px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full font-semibold hover:shadow-orange-500/50 shadow-lg transition-all duration-300 hover:scale-105">
                View Our Menu
            </a>
        </div>
    </div>
</section>

<!-- Section 2: QR Table Ordering -->
<section class="px-6 pb-20 max-w-6xl mx-auto">
    <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 rounded-2xl p-8 md:p-12 border border-gray-700/50 card-hover">
        <div class="text-center mb-10">
            <div class="text-5xl mb-4">📱</div>
            <h2 class="text-3xl md:text-4xl font-bold mb-3">QR <span class="text-sky-400">Table Ordering</span></h2>
            <p class="text-gray-400 text-lg">No waiting, no hassle — order directly from your table!</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
            <div class="text-center">
                <div class="w-20 h-20 bg-sky-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">📷</span>
                </div>
                <div class="text-sm text-sky-400 font-bold mb-2">STEP 1</div>
                <h3 class="font-bold text-lg mb-2">Scan QR Code</h3>
                <p class="text-gray-400 text-sm">Find the QR code on your table and scan it with your phone camera.</p>
            </div>

            <div class="text-center">
                <div class="w-20 h-20 bg-orange-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">🍽️</span>
                </div>
                <div class="text-sm text-orange-400 font-bold mb-2">STEP 2</div>
                <h3 class="font-bold text-lg mb-2">Browse & Order</h3>
                <p class="text-gray-400 text-sm">Explore our full menu, customize your order, and place it instantly.</p>
            </div>

            <div class="text-center">
                <div class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-3xl">✅</span>
                </div>
                <div class="text-sm text-green-400 font-bold mb-2">STEP 3</div>
                <h3 class="font-bold text-lg mb-2">Enjoy Your Meal</h3>
                <p class="text-gray-400 text-sm">Sit back and relax — your food will be served right at your table.</p>
            </div>
        </div>

        <div class="text-center mt-10 bg-gray-800/50 rounded-xl p-6 max-w-2xl mx-auto border border-gray-700/30">
            <!-- <p class="text-gray-300">💡 Available at all tables in our cafe. No app download needed!</p> -->
            <p class="text-gray-300">💡 Coming Soon!</p>
        </div>
    </div>
</section>

<!-- Section 3: Hall Booking -->
<section class="px-6 pb-20 max-w-6xl mx-auto">
    <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 rounded-2xl p-8 md:p-12 border border-gray-700/50 card-hover">
        <div class="text-center mb-10">
            <div class="text-5xl mb-4">🏛️</div>
            <h2 class="text-3xl md:text-4xl font-bold mb-3">Hall <span class="text-orange-400">Booking</span></h2>
            <p class="text-gray-400 text-lg">Host your small gatherings, birthday parties, or private events with us.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto items-center">
            <!-- Hall Info -->
            <div class="space-y-4">
                <div class="flex items-center gap-3 bg-gray-800/50 rounded-lg p-4 border border-gray-700/30">
                    <span class="text-2xl">👥</span>
                    <div>
                        <div class="text-sm text-gray-400">Capacity</div>
                        <div class="font-bold text-lg">Up to 15 people</div>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-gray-800/50 rounded-lg p-4 border border-gray-700/30">
                    <span class="text-2xl">🎉</span>
                    <div>
                        <div class="text-sm text-gray-400">Perfect For</div>
                        <div class="font-bold text-lg">Birthdays, Small Parties, Meetings</div>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-gray-800/50 rounded-lg p-4 border border-gray-700/30">
                    <span class="text-2xl">🍕</span>
                    <div>
                        <div class="text-sm text-gray-400">Food Service</div>
                        <div class="font-bold text-lg">Full menu available for your event</div>
                    </div>
                </div>
            </div>

            <!-- Hall Gallery -->
            <div>
                <% const hallImages = settings?.hallGalleryImages || []; %>
                <% if (hallImages.length > 0) { %>
                <div class="overflow-hidden rounded-xl">
                    <div class="flex w-max hall-scroll">
                        <% hallImages.forEach(img => { %>
                        <div class="mx-2 min-w-[280px]">
                            <img src="<%= getImageUrl(img, 'gallery-images') %>" alt="Hall Ambience" class="w-full h-56 object-cover rounded-xl border border-gray-700 hover:scale-105 transition-transform duration-500">
                        </div>
                        <% }); %>
                        <% hallImages.forEach(img => { %>
                        <div class="mx-2 min-w-[280px]">
                            <img src="<%= getImageUrl(img, 'gallery-images') %>" alt="Hall Ambience" class="w-full h-56 object-cover rounded-xl border border-gray-700 hover:scale-105 transition-transform duration-500">
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } else { %>
                <div class="bg-gray-800/50 rounded-xl h-56 flex items-center justify-center border border-gray-700/30">
                    <p class="text-gray-500">Hall images coming soon</p>
                </div>
                <% } %>
            </div>
        </div>

        <div class="text-center mt-8 pt-6 border-t border-gray-700/30">
            <a href="tel:<%= settings?.phone || '' %>" class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-sky-500 to-sky-600 rounded-full font-bold text-lg shadow-lg hover:shadow-sky-500/50 transition-all duration-300 hover:scale-105">
                📞 Call to Book: <%= settings?.phone || 'Contact Us' %>
            </a>
            <p class="text-gray-500 text-sm mt-3">Call us for availability, pricing, and to reserve your date.</p>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="px-6 pb-20 text-center">
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/menu" class="px-8 py-4 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full font-semibold shadow-lg hover:shadow-orange-500/50 transition-all duration-300 hover:scale-105">
            Explore Our Menu
        </a>
        <a href="/" class="px-8 py-4 bg-gradient-to-r from-sky-500 to-sky-600 rounded-full font-semibold shadow-lg hover:shadow-sky-500/50 transition-all duration-300 hover:scale-105">
            Back to Home
        </a>
    </div>
</section>

<%- include("partials/footer") %>



</body>
</html>
