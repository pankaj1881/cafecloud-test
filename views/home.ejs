<!DOCTYPE html>
<html>
<head>
    <title><%= settings?.cafeName || "Cafe" %></title>
    
    <!-- Favicon -->
    <%- include("./partials/favicon") %>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
@keyframes scrollGallery {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.animate-scroll { animation: scrollGallery 50s linear infinite; }
@keyframes scrollReviews {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.animate-scroll-reviews { animation: scrollReviews 40s linear infinite; }
.animate-scroll-reviews:hover { animation-play-state: paused; }
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}
.fade-in-up { animation: fadeInUp 1s ease-out; }
@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}
.float { animation: float 3s ease-in-out infinite; }
@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}
@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}
@keyframes glow {
    0%, 100% { box-shadow: 0 4px 20px rgba(251, 191, 36, 0.6), 0 0 30px rgba(251, 191, 36, 0.4); }
    50% { box-shadow: 0 4px 30px rgba(251, 191, 36, 0.9), 0 0 50px rgba(251, 191, 36, 0.6); }
}
@keyframes glowRed {
    0%, 100% { box-shadow: 0 4px 20px rgba(239, 68, 68, 0.6), 0 0 30px rgba(239, 68, 68, 0.4); }
    50% { box-shadow: 0 4px 30px rgba(239, 68, 68, 0.9), 0 0 50px rgba(239, 68, 68, 0.6); }
}
@keyframes glowBlue {
    0%, 100% { box-shadow: 0 4px 20px rgba(59, 130, 246, 0.6), 0 0 30px rgba(59, 130, 246, 0.4); }
    50% { box-shadow: 0 4px 30px rgba(59, 130, 246, 0.9), 0 0 50px rgba(59, 130, 246, 0.6); }
}
@keyframes neon-glow {
    0%, 100% {
        filter: drop-shadow(0 0 5px #0ea5e9) drop-shadow(0 0 10px #0ea5e9) drop-shadow(0 0 15px #f97316);
    }
    50% {
        filter: drop-shadow(0 0 10px #f97316) drop-shadow(0 0 15px #f97316) drop-shadow(0 0 20px #0ea5e9);
    }
}
.neon-logo {
    animation: neon-glow 2s ease-in-out infinite;
}
.gradient-text {
    background: linear-gradient(135deg, #38bdf8 0%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.map-fade {
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 100%);
}
.cloud-simple {
    position: relative;
    padding: 12px 20px;
    border-radius: 20px;
    max-width: 280px;
    margin: 0 auto;
    font-size: 0.9rem;
    animation: bounce 2s ease-in-out infinite;
}
.offer-cloud {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: white;
    animation: pulse 2s ease-in-out infinite, glow 2s ease-in-out infinite;
    border-radius: 50px;
    border: 3px solid rgba(255, 255, 255, 0.5);
    padding: 14px 22px;
}
.closure-cloud {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    animation: bounce 2s ease-in-out infinite, glowRed 2s ease-in-out infinite;
}
.announcement-cloud {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    animation: bounce 2s ease-in-out infinite, glowBlue 2s ease-in-out infinite;
}
@media (max-width: 768px) {
    .cloud-simple {
        max-width: 220px;
        padding: 10px 16px;
        font-size: 0.8rem;
    }
}
</style>
</head>
<body class="bg-black">
    <%- include("partials/navbar") %>

<!-- HERO -->
<div class="relative min-h-screen md:h-screen bg-cover bg-center overflow-hidden" style="background-image: url('<%= heroImage %>')">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/70 to-black"></div>
    <div class="relative z-10 min-h-screen md:h-full flex flex-col items-center justify-start md text-center text-white px-4 pt-24 pb-20 md:pt-16 md:py-0 fade-in-up">
       
        <!-- Cloud Announcement -->
        <% if (settings?.announcement?.enabled && settings.announcement.title) { %>
        <div class="mb-8">
            <div class="cloud-simple <%= settings.announcement.type %>-cloud">
                <% if (settings.announcement.type === 'offer') { %>
                    <div class="text-xs font-bold mb-1">🔥 SPECIAL OFFER 🔥</div>
                <% } %>
                <div class="text-sm font-bold mb-1"><%= settings.announcement.title %></div>
                <div class="text-xs"><%= settings.announcement.description %></div>
                <% if (settings.announcement.date) { %>
                    <div class="text-xs mt-1 opacity-75">📅 <%= settings.announcement.date %></div>
                <% } %>
            </div>
        </div>
        <% } %>
       
        <!-- Neon Logo -->
        <div class="mb-2 mt-8 md:mt-0 float">
            <img src="<%= logoImage %>" alt="Cafe Cloud Logo" class="neon-logo w-48 h-48 md:w-64 md:h-64 mx-auto object-contain" onerror="this.style.display='none'">
        </div>
        
        <div class="float">
            <h1 class="text-6xl md:text-8xl font-extrabold mb-6 tracking-tight">
                <span class="text-sky-400 drop-shadow-[0_0_30px_rgba(56,189,248,0.5)]">Cafe</span>
                <span class="text-orange-500 drop-shadow-[0_0_30px_rgba(251,146,60,0.5)]">Cloud</span>
            </h1>
        </div>
        <p class="max-w-3xl text-white text-xl md:text-2xl mb-10 leading-relaxed font-light drop-shadow-lg"><%= settings?.heroQuote || 'Experience handcrafted coffee, wood-fired pizza, and unforgettable vibes.' %></p>
        <a href="/menu" class="group relative inline-flex items-center justify-center px-10 py-4 text-lg font-bold text-white bg-gradient-to-r from-orange-500 to-orange-600 rounded-full overflow-hidden shadow-2xl transition-all duration-300 hover:scale-110 hover:shadow-orange-500/50">
            <span class="relative z-10">Explore Menu</span>
            <span class="absolute inset-0 bg-gradient-to-r from-orange-600 to-orange-700 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
        </a>
    </div>
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-8 h-8 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </div>
</div>

<!-- ABOUT -->
<div class="bg-gradient-to-b from-black via-gray-900 to-black text-white py-24">
    <div class="container mx-auto text-center px-6">
        <h2 class="text-5xl md:text-6xl font-extrabold mb-8 gradient-text">About Cafe Cloud</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-sky-400 to-orange-500 mx-auto mb-10 rounded-full"></div>
        <p class="max-w-4xl mx-auto text-white text-lg md:text-xl leading-relaxed font-light"><%= settings?.description %></p>
    </div>
</div>

<!-- GALLERY -->
<div class="bg-black py-24 overflow-hidden">
    <div class="container mx-auto px-6">
        <h2 class="text-5xl md:text-6xl font-extrabold text-center mb-16">
            <span class="gradient-text">Our Ambience</span>
        </h2>
        <div class="relative w-full overflow-hidden rounded-2xl">
            <div class="flex w-max animate-scroll">
                <% galleryImages.forEach(img => { %>
                    <div class="mx-4 min-w-[320px] md:min-w-[400px]">
                        <img src="<%= getImageUrl(img, 'gallery-images') %>" class="w-full h-72 md:h-80 object-cover rounded-2xl shadow-2xl transform hover:scale-105 transition-transform duration-500 border-2 border-gray-800">
                    </div>
                <% }) %>
                <% galleryImages.forEach(img => { %>
                    <div class="mx-4 min-w-[320px] md:min-w-[400px]">
                        <img src="<%= getImageUrl(img, 'gallery-images') %>" class="w-full h-72 md:h-80 object-cover rounded-2xl shadow-2xl transform hover:scale-105 transition-transform duration-500 border-2 border-gray-800">
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<!-- REVIEWS -->
<% if (reviews && reviews.length > 0) { %>
<div class="bg-gradient-to-b from-black via-gray-900 to-black text-white py-24">
    <div class="container mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-5xl md:text-6xl font-extrabold mb-4 gradient-text">What Our Customers Say</h2>
            <div class="w-32 h-1 bg-gradient-to-r from-sky-400 to-orange-500 mx-auto rounded-full"></div>
        </div>
    </div>
    <% if (reviews.length >= 4) { %>
    <div class="relative w-full overflow-hidden">
        <div class="flex w-max animate-scroll-reviews">
            <% reviews.forEach(review => { %>
                <div class="mx-3 min-w-[300px] max-w-[300px] bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700 shadow-xl">
                    <div class="flex items-center mb-4">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-5 h-5 <%= i <= review.rating ? 'text-orange-500' : 'text-gray-600' %>" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        <% } %>
                    </div>
                    <% if (review.message) { %>
                        <p class="text-white text-sm leading-relaxed mb-4 italic line-clamp-4">"<%= review.message %>"</p>
                    <% } %>
                    <div class="flex items-center justify-between">
                        <p class="text-sky-400 font-semibold">- <%= review.name.split(' ')[0] %></p>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-500/20 text-green-400 border border-green-500/30">✓ Verified</span>
                    </div>
                    <p class="text-gray-500 text-xs mt-2"><%= new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                </div>
            <% }) %>
            <% reviews.forEach(review => { %>
                <div class="mx-3 min-w-[300px] max-w-[300px] bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700 shadow-xl">
                    <div class="flex items-center mb-4">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-5 h-5 <%= i <= review.rating ? 'text-orange-500' : 'text-gray-600' %>" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        <% } %>
                    </div>
                    <% if (review.message) { %>
                        <p class="text-white text-sm leading-relaxed mb-4 italic line-clamp-4">"<%= review.message %>"</p>
                    <% } %>
                    <div class="flex items-center justify-between">
                        <p class="text-sky-400 font-semibold">- <%= review.name.split(' ')[0] %></p>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-500/20 text-green-400 border border-green-500/30">✓ Verified</span>
                    </div>
                    <p class="text-gray-500 text-xs mt-2"><%= new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                </div>
            <% }) %>
        </div>
    </div>
    <% } else { %>
    <div class="container mx-auto px-6">
        <div class="flex flex-wrap justify-center gap-6">
            <% reviews.forEach(review => { %>
                <div class="w-[300px] bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700 shadow-xl">
                    <div class="flex items-center mb-4">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-5 h-5 <%= i <= review.rating ? 'text-orange-500' : 'text-gray-600' %>" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        <% } %>
                    </div>
                    <% if (review.message) { %>
                        <p class="text-white text-sm leading-relaxed mb-4 italic">"<%= review.message %>"</p>
                    <% } %>
                    <div class="flex items-center justify-between">
                        <p class="text-sky-400 font-semibold">- <%= review.name.split(' ')[0] %></p>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-500/20 text-green-400 border border-green-500/30">✓ Verified</span>
                    </div>
                    <p class="text-gray-500 text-xs mt-2"><%= new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                </div>
            <% }) %>
        </div>
    </div>
    <% } %>
</div>
<% } %>

<!-- CONTACT -->
<div class="bg-gradient-to-b from-black via-gray-900 to-black text-white py-24">
    <div class="container mx-auto text-center px-6">
        <h2 class="text-5xl md:text-6xl font-extrabold mb-12 gradient-text">Visit Us</h2>
        <div class="max-w-5xl mx-auto">
            <!-- Mini Map -->
            <div class="relative mb-6">
                <a href="<%= settings?.mapLink %>" target="_blank" class="relative block">
                    <div class="relative overflow-hidden h-96 rounded-3xl map-fade">
                        <iframe 
                            src="<%= settings?.mapLink ? (settings.mapLink.includes('/embed') ? settings.mapLink : settings.mapLink.replace('https://maps.google.com/?q=', 'https://www.google.com/maps/embed/v1/place?key=AIzaSyBFw0Qbyq9zTFTd-tuwX1h3M5UBXqSFXbI&q=').replace('https://www.google.com/maps/place/', 'https://www.google.com/maps/embed/v1/place?key=AIzaSyBFw0Qbyq9zTFTd-tuwX1h3M5UBXqSFXbI&q=').replace('https://goo.gl/maps/', 'https://www.google.com/maps/embed?pb=') + '&zoom=15') : 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3000!2d73.3!3d17.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTfCsDA3JzI0LjQiTiA3M8KwMDcnMjQuNCJF!5e0!3m2!1sen!2sin!4v1234567890&zoom=15' %>" 
                            width="100%" 
                            height="100%" 
                            style="border:0;outline:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                            class="block">
                        </iframe>
                    </div>
                </a>
            </div>
            <!-- Social & Contact Icons -->
            <div class="flex items-center justify-center gap-4">
                <a href="<%= settings?.instagram || '#' %>" target="_blank" class="group bg-gradient-to-br from-pink-500/20 to-purple-600/20 hover:from-pink-500/30 hover:to-purple-600/30 p-4 rounded-full border border-pink-500/30 hover:border-pink-400 transition-all duration-300 backdrop-blur-sm">
                    <svg class="w-6 h-6 text-pink-400 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href="<%= settings?.facebook || '#' %>" target="_blank" class="group bg-gradient-to-br from-blue-500/20 to-blue-700/20 hover:from-blue-500/30 hover:to-blue-700/30 p-4 rounded-full border border-blue-500/30 hover:border-blue-400 transition-all duration-300 backdrop-blur-sm">
                    <svg class="w-6 h-6 text-blue-400 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href="tel:<%= settings?.phone %>" class="group bg-gradient-to-br from-sky-500/20 to-blue-500/20 hover:from-sky-500/30 hover:to-blue-500/30 p-4 rounded-full border border-sky-500/30 hover:border-sky-400 transition-all duration-300 backdrop-blur-sm">
                    <svg class="w-6 h-6 text-sky-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </a>
            </div>
        </div>
    </div>
</div>

    <%- include("partials/footer") %>
</body>

</html>
