<!DOCTYPE html>
<html>
<head>
    <title>Under Maintenance - Cafe Cloud</title>
    <%- include("./partials/favicon") %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        .float { animation: float 3s ease-in-out infinite; }
        @keyframes neon-glow {
            0%, 100% {
                filter: drop-shadow(0 0 5px #0ea5e9) drop-shadow(0 0 10px #0ea5e9) drop-shadow(0 0 15px #f97316);
            }
            50% {
                filter: drop-shadow(0 0 10px #f97316) drop-shadow(0 0 15px #f97316) drop-shadow(0 0 20px #0ea5e9);
            }
        }
        .neon-logo { animation: neon-glow 2s ease-in-out infinite; }
    </style>
</head>
<body class="bg-black min-h-screen flex items-center justify-center">
    <div class="text-center px-6">
        <!-- Logo -->
        <div class="mb-8 float">
            <img src="/images/logo.png" alt="Cafe Cloud Logo" class="neon-logo w-48 h-48 md:w-64 md:h-64 mx-auto object-contain" onerror="this.style.display='none'">
        </div>
        
        <!-- Cafe Name -->
        <h1 class="text-6xl md:text-8xl font-extrabold mb-6 tracking-tight">
            <span class="text-sky-400 drop-shadow-[0_0_30px_rgba(56,189,248,0.5)]">Cafe</span>
            <span class="text-orange-500 drop-shadow-[0_0_30px_rgba(251,146,60,0.5)]">Cloud</span>
        </h1>
        
        <!-- Maintenance Message -->
        <div class="mb-8">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                🔧 We're Under Maintenance
            </h2>
            <p class="text-xl md:text-2xl text-gray-300 max-w-2xl mx-auto">
                <%= message || "We're cooking something special!" %>
            </p>
        </div>
        
        <!-- Animated Icon -->
        <div class="mb-8">
            <div class="inline-block text-6xl animate-bounce">
                ☕
            </div>
        </div>
        
        <!-- Message -->
        <p class="text-lg text-gray-400 mb-8">
            We'll be back soon!
        </p>
    
    </div>
</body>
</html>
