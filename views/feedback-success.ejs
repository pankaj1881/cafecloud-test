<!DOCTYPE html>
<html>
<head>
    <title>Thank You - <%= settings?.cafeName %></title>
    <%- include("./partials/favicon") %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes checkmark {
            0% { stroke-dashoffset: 100; }
            100% { stroke-dashoffset: 0; }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .checkmark {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: checkmark 0.8s ease-out forwards;
        }
        .fade-in-up {
            animation: fadeInUp 0.6s ease-out forwards;
        }
        .gradient-text {
            background: linear-gradient(135deg, #38bdf8 0%, #fb923c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
</head>
<body class="bg-gradient-to-b from-black via-gray-900 to-black text-white min-h-screen flex items-center justify-center">

<div class="container mx-auto px-6 py-16">
    <div class="max-w-2xl mx-auto text-center">
        
        <!-- Success Icon -->
        <div class="mb-8 fade-in-up">
            <div class="inline-flex items-center justify-center w-32 h-32 bg-gradient-to-br from-green-400 to-green-600 rounded-full shadow-2xl shadow-green-500/50">
                <svg class="w-20 h-20 text-white checkmark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
        </div>

        <!-- Success Message -->
        <div class="fade-in-up" style="animation-delay: 0.2s;">
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 gradient-text">
                Thank You!
            </h1>
            <div class="w-32 h-1 bg-gradient-to-r from-sky-400 to-orange-500 mx-auto rounded-full mb-8"></div>
            
            <p class="text-xl md:text-2xl text-gray-300 mb-4 font-light">
                Your feedback has been received successfully
            </p>
            <p class="text-gray-400 mb-12 max-w-lg mx-auto">
                We truly appreciate you taking the time to share your experience with us. Your input helps us serve you better!
            </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center fade-in-up" style="animation-delay: 0.4s;">
            <a href="/" 
               class="px-8 py-4 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 rounded-full font-bold shadow-lg hover:shadow-orange-500/50 transition-all duration-300 transform hover:scale-105">
                Back to Home
            </a>
            <a href="/menu" 
               class="px-8 py-4 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 rounded-full font-bold shadow-lg hover:shadow-sky-500/50 transition-all duration-300 transform hover:scale-105">
                View Menu
            </a>
        </div>

        <!-- Additional Info -->
        <div class="mt-16 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-8 border border-gray-700 fade-in-up" style="animation-delay: 0.6s;">
            <div class="flex items-start space-x-4">
                <svg class="w-8 h-8 text-orange-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div class="text-left">
                    <h3 class="text-lg font-bold text-sky-400 mb-2">What happens next?</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Our team will review your feedback carefully. If you've shared your contact details, we may reach out to you with exclusive offers or to address any concerns you've mentioned.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Auto redirect after 10 seconds
    setTimeout(() => {
        window.location.href = '/';
    }, 10000);
</script>

</body>
</html>
